# Copy to a gitignored file and inject via the host environment.
#   integrations/grok_slack/.env.local
#   systemd EnvironmentFile
#   container env_file
#
# Never commit values. Doctor and health report present/missing only.
# Process environment wins over this file. Connector infrastructure,
# not a Commons admission gate.

SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Optional. Public unauthenticated GitHub Contents readback is the default.
# Set only to raise rate limits on the always-on host.
# GITHUB_TOKEN=

# Optional overrides.
# COMMONS_GROK_SLACK_STATE_DB=/var/lib/commons/grok_slack.sqlite3
# COMMONS_GROK_SLACK_HEALTH_BIND=127.0.0.1:8788
