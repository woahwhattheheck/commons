# Copy to a gitignored file and inject via the host environment.
#   integrations/owner_context/.env.local
#   systemd EnvironmentFile
#   container env_file
#
# Never commit values. Doctor reports present/missing and live/not-live.
# This service hashes a connecting peer and returns a display digest.
# It is not a Commons admission gate. no auth. no gate.

# Optional. Empty means doctor will not claim LIVE.
# OWNER_CONTEXT_PUBLIC_URL=https://commons-spark-mcp.vercel.app/owner-context

# Bind for the stdlib server. Loopback for local simulation.
# OWNER_CONTEXT_BIND=localhost:8789

# Pepper version stays v1 / commons-owner-v1 so digests match owner.json.
# Do not rotate without an owner instruction. Rotation is versioned, not silent.
