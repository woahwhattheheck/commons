{
  "schema": "commons-headless-model-control/v1",
  "service": "commons-claude-headless-gateway",
  "peer": "CLAUDE",
  "listen": "http://127.0.0.1:8879",
  "state_dir": "~/.commons/claude_headless",
  "reuses": [
    "claude -p --output-format stream-json --verbose --session-id <uuid>",
    "claude -p --output-format stream-json --verbose --resume <uuid>",
    "~/.claude/projects/<cwd-key>/<session>.jsonl",
    "integrations/gemini_slack/peer_tool_gateway.py (/health + /v1/events cursor + /v1/requests/{id} shape)",
    "~/.commons/ state directory convention from integrations/grok_slack"
  ],
  "start": [
    "python integrations/claude_headless/gateway.py --detach",
    "integrations/claude_headless/run.ps1"
  ],
  "stop": "python integrations/claude_headless/gateway.py --stop",
  "client": "python integrations/claude_headless/client.py <health|submit|followup|resume|status|events|cancel|runs|session|tail>",
  "routes": {
    "health": "GET /health",
    "submit": "POST /v1/runs",
    "submit_alias": "POST /v1/message",
    "list": "GET /v1/runs?status=&session_id=&limit=",
    "run": "GET /v1/runs/{run_id}?wait_ms=",
    "run_alias": "GET /v1/requests/{run_id}?wait_ms=",
    "run_events": "GET /v1/runs/{run_id}/events?after=&wait_ms=",
    "followup": "POST /v1/runs/{run_id}/followup",
    "cancel": "POST /v1/runs/{run_id}/cancel",
    "session": "GET /v1/sessions/{session_id}",
    "session_followup": "POST /v1/sessions/{session_id}/runs",
    "events": "GET /v1/events?after=&wait_ms=&run_id=&session_id="
  },
  "run_fields": [
    "prompt", "prompt_utf8_base64", "cwd", "model", "max_turns", "permission_mode", "effort",
    "append_system_prompt", "agent", "allowed_tools", "disallowed_tools", "add_dirs", "mcp_config",
    "strict_mcp_config", "fork_session", "bare", "session_id", "label", "from", "retain_prompt", "wait_ms", "async"
  ],
  "statuses": ["queued", "starting", "running", "completed", "failed", "cancelled", "interrupted"],
  "headless": {
    "child_creationflags": ["CREATE_NO_WINDOW", "CREATE_NEW_PROCESS_GROUP"],
    "env_removed": ["CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT"],
    "prompt_transport": "stdin",
    "gateway_process": "pythonw.exe, DETACHED_PROCESS | CREATE_NO_WINDOW"
  },
  "identifiers": {
    "run_id": "32 hex, one CLI process",
    "session_id": "UUID, one conversation; durable in the CLI transcript on disk",
    "event_id": "monotonic integer cursor across all runs"
  },
  "attribution": "the from field is optional and recorded as submitted_by; nothing about the caller is checked",
  "tests": "python test_claude_headless.py",
  "receipt": "p/cleat-c1-headless-claude-20260904-01.md"
}
