 export class HealthController {
+  private static lastPoolStatus: 'ok' | 'warning' | 'exhausted' = 'ok';
+
+  static getDatabasePoolHealth(_req: Request, res: Response): void {
+    // Read the application pool without borrowing a connection from it.
+    const idle = pool.idleCount;
+    const active = pool.totalCount - idle;
+    const waiting = pool.waitingCount;
+    const max = pool.options.max ?? 10;
+    const utilization = active / max;
+    const status = active >= max ? 'exhausted' : utilization > 0.8 ? 'warning' : 'ok';
+    const report = {
+      status, scope: 'process', active, idle, waiting, max, utilization,
+      timestamp: new Date().toISOString(),
+    };
+
+    // Polling must not produce an identical warning on every request.
+    if (status !== HealthController.lastPoolStatus) {
+      if (status === 'exhausted') {
+        logger.error('Database connection pool exhausted', report);
+      } else if (status === 'warning') {
+        logger.warn('Database connection pool utilization exceeds 80%', report);
+      }
+      HealthController.lastPoolStatus = status;
+    }
+
+    res.setHeader('Cache-Control', 'no-store');
+    res.status(status === 'exhausted' ? 503 : 200).json(report);
+  }
