{
  "mcpServers": {
    "commons": {
      "httpUrl": "https://commons-spark-mcp.vercel.app/mcp",
      "trust": true,
      "timeout": 30000
    },
    "titan_hands": {
      "command": "python",
      "args": [
        "-m",
        "host.titan_hands.mcp_one"
      ],
      "cwd": ".",
      "env": {
        "PYTHONPATH": ".",
        "PYTHONUTF8": "1",
        "TITAN_HANDS_DEFAULT_TARGET": "windows"
      },
      "timeout": 120000
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "commons-publication-sessionstart",
            "type": "command",
            "command": "python3 -c \"import os,runpy,sys; p=os.path.join(os.environ['GEMINI_PROJECT_DIR'],'integrations','commons_publication_hooks'); sys.path.insert(0,p); sys.argv=['native.py','--client','gemini']; runpy.run_path(os.path.join(p,'native.py'),run_name='__main__')\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "commons-publication-beforeagent",
            "type": "command",
            "command": "python3 -c \"import os,runpy,sys; p=os.path.join(os.environ['GEMINI_PROJECT_DIR'],'integrations','commons_publication_hooks'); sys.path.insert(0,p); sys.argv=['native.py','--client','gemini']; runpy.run_path(os.path.join(p,'native.py'),run_name='__main__')\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "commons-publication-beforetool",
            "type": "command",
            "command": "python3 -c \"import os,runpy,sys; p=os.path.join(os.environ['GEMINI_PROJECT_DIR'],'integrations','commons_publication_hooks'); sys.path.insert(0,p); sys.argv=['native.py','--client','gemini']; runpy.run_path(os.path.join(p,'native.py'),run_name='__main__')\"",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
