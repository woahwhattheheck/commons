+    // Remote playback
+
+    @Override
+    public boolean onControlRequest(Intent intent, final MediaRouter.ControlRequestCallback callback) {
+        final String action = intent.getAction();
+        if (!intent.hasCategory(MediaControlIntent.CATEGORY_REMOTE_PLAYBACK) || action == null) return false;
+        final String sessionId = intent.getStringExtra(MediaControlIntent.EXTRA_SESSION_ID);
+        final String itemId = intent.getStringExtra(MediaControlIntent.EXTRA_ITEM_ID);
+        final long position = intent.getLongExtra(MediaControlIntent.EXTRA_ITEM_CONTENT_POSITION, 0);
+        final CastRemotePlayback.Callback resultCallback = new ResultCallback(action, callback);
+        final PlaybackTask task;
+        switch (action) {
+            case MediaControlIntent.ACTION_PLAY: {
+                final Uri uri = intent.getData();
+                if (uri == null) return false;
+                final String contentType = intent.getType();
+                final JSONObject metadata = toCastMetadata(intent.getBundleExtra(MediaControlIntent.EXTRA_ITEM_METADATA), contentType);
+                final PendingIntent receiver = intent.getParcelableExtra(MediaControlIntent.EXTRA_ITEM_STATUS_UPDATE_RECEIVER);
+                task = new PlaybackTask() {
+                    @Override
+                    public void run(CastRemotePlayback playback) {
+                        String previousItemId = playback.snapshot().itemId;
+                        playback.play(uri.toString(), contentType, metadata, position, sessionId, resultCallback);
+                        // The previous item's receiver was told about its replacement during play().
+                        if (!TextUtils.equals(previousItemId, playback.snapshot().itemId)) itemStatusReceiver = receiver;
+                    }
+                };
+                break;
+            }
+            case MediaControlIntent.ACTION_SEEK:
+                task = new PlaybackTask() {
+                    @Override
+                    public void run(CastRemotePlayback playback) {
+                        playback.seek(sessionId, itemId, position, resultCallback);
+                    }
+                };
+                break;
+            case MediaControlIntent.ACTION_GET_STATUS:
+                task = new PlaybackTask() {
+                    @Override
+                    public void run(CastRemotePlayback playback) {
+                        playback.getStatus(sessionId, itemId, resultCallback);
+                    }
+                };
+                break;
+            case MediaControlIntent.ACTION_PAUSE:
+                task = new PlaybackTask() {
+                    @Override
+                    public void run(CastRemotePlayback playback) {
+                        playback.pause(sessionId, resultCallback);
+                    }
+                };
+                break;
+            case MediaControlIntent.ACTION_RESUME:
+                task = new PlaybackTask() {
+                    @Override
+                    public void run(CastRemotePlayback playback) {
+                        playback.resume(sessionId, resultCallback);
+                    }
+                };
+                break;
+            case MediaControlIntent.ACTION_STOP:
+                task = new PlaybackTask() {
+                    @Override
+                    public void run(CastRemotePlayback playback) {
+                        playback.stop(sessionId, resultCallback);
+                    }
+                };
+                break;
+            case MediaControlIntent.ACTION_START_SESSION: {
+                final PendingIntent receiver = intent.getParcelableExtra(MediaControlIntent.EXTRA_SESSION_STATUS_UPDATE_RECEIVER);
+                task = new PlaybackTask() {
+                    @Override
+                    public void run(CastRemotePlayback playback) {
+                        // The replaced session, if any, is reported to its own receiver first.
+                        playback.startSession(resultCallback);
+                        sessionStatusReceiver = receiver;
+                        itemStatusReceiver = null;
+                    }
+                };
+                break;
+            }
+            case MediaControlIntent.ACTION_GET_SESSION_STATUS:
+                task = new PlaybackTask() {
+                    @Override
+                    public void run(CastRemotePlayback playback) {
+                        playback.getSessionStatus(sessionId, resultCallback);
+                    }
+                };
+                break;
+            case MediaControlIntent.ACTION_END_SESSION:
+                task = new PlaybackTask() {
+                    @Override
+                    public void run(CastRemotePlayback playback) {
+                        playback.endSession(sessionId, resultCallback);
+                    }
+                };
+                break;
+            default:
+                Log.d(TAG, "Unsupported control request " + action + " for " + routeId);
+                return false;
+        }
+        if (!runPlayback(task, true)) {
+            resultCallback.onError("Route released", MediaControlIntent.ERROR_UNKNOWN);
+        }
+        return true;
+    }
+
+    private interface PlaybackTask {
+        void run(CastRemotePlayback playback);
+    }
+
+    private boolean runPlayback(PlaybackTask task) {
+        return runPlayback(task, false);
+    }
+
+    /**
+     * Run a task on the playback executor.
+     *
+     * @param create whether to set up remote playback if no control request was handled yet
+     * @return false if the task was not run because the controller is released or remote playback is not set up
+     */
+    private boolean runPlayback(final PlaybackTask task, boolean create) {
+        final ScheduledThreadPoolExecutor executor;
+        final CastRemotePlayback playback;
+        synchronized (this) {
+            if (playbackExecutor == null) {
+                if (!create || released) return false;
+                playbackExecutor = new ScheduledThreadPoolExecutor(1, new ThreadFactory() {
+                    @Override
+                    public Thread newThread(@NonNull Runnable r) {
+                        Thread thread = new Thread(r, "CastRemotePlayback-" + routeId);
+                        thread.setDaemon(true);
+                        return thread;
+                    }
+                });
+                playbackExecutor.setRemoveOnCancelPolicy(true);
+                this.playback = new CastRemotePlayback(new PlaybackConnection(), playbackExecutor, new PlaybackListener());
+            }
+            executor = playbackExecutor;
+            playback = this.playback;
+        }
+        try {
+            executor.execute(new Runnable() {
+                @Override
+                public void run() {
+                    try {
+                        task.run(playback);
+                    } catch (RuntimeException e) {
+                        Log.w(TAG, "Remote playback task failed", e);
+                    }
+                }
+            });
+            return true;
+        } catch (RejectedExecutionException e) {
+            return false;
+        }
+    }
+
+    private class PlaybackConnection implements CastRemotePlayback.Connection {
+        @Override
+        public void launchApplication(String applicationId) {
+            CastDeviceSession session = getSession();
+            if (session == null) {
+                runPlayback(new PlaybackTask() {
+                    @Override
+                    public void run(CastRemotePlayback playback) {
+                        playback.onApplicationConnectionFailed(CastDeviceSession.STATUS_NETWORK_ERROR);
+                    }
+                });
+                return;
+            }
+            // Register first so no media status sent right after attaching is dropped.
+            session.registerNamespace(CastRemotePlayback.NAMESPACE_MEDIA);
+            session.launchApplication(applicationId, false, null);
+        }
+
+        @Override
+        public void sendMessage(String namespace, String message, final long requestId) {
+            CastDeviceSession session = getSession();
+            if (session != null) {
+                session.sendMessage(namespace, message, requestId);
+            } else {
+                runPlayback(new PlaybackTask() {
+                    @Override
+                    public void run(CastRemotePlayback playback) {
+                        playback.onSendMessageFailure(requestId);
+                    }
+                });
+            }
+        }
+
+        @Override
+        public void stopApplication() {
+            CastDeviceSession session = getSession();
+            if (session != null) session.stopApplication(null);
+        }
+    }
+
+    private class PlaybackListener implements CastRemotePlayback.Listener {
+        @Override
+        public void onStatusChanged(CastRemotePlayback.Status status) {
+            if (status.itemId != null && itemStatusReceiver != null) {
+                Intent update = new Intent()
+                        .putExtra(MediaControlIntent.EXTRA_SESSION_ID, status.sessionId)
+                        .putExtra(MediaControlIntent.EXTRA_SESSION_STATUS, toSessionStatusBundle(status))
+                        .putExtra(MediaControlIntent.EXTRA_ITEM_ID, status.itemId)
+                        .putExtra(MediaControlIntent.EXTRA_ITEM_STATUS, toItemStatusBundle(status));
+                if (!sendUpdate(itemStatusReceiver, update)) itemStatusReceiver = null;
+            }
+            if (status.sessionId != null && sessionStatusReceiver != null) {
+                Intent update = new Intent()
+                        .putExtra(MediaControlIntent.EXTRA_SESSION_ID, status.sessionId)
+                        .putExtra(MediaControlIntent.EXTRA_SESSION_STATUS, toSessionStatusBundle(status));
+                if (!sendUpdate(sessionStatusReceiver, update)) sessionStatusReceiver = null;
+            }
+        }
+
+        private boolean sendUpdate(PendingIntent receiver, Intent update) {
+            try {
+                receiver.send(context, 0, update);
+                return true;
+            } catch (PendingIntent.CanceledException e) {
+                return false;
+            }
+        }
+    }
+
+    private class ResultCallback implements CastRemotePlayback.Callback {
+        private final String action;
+        private final MediaRouter.ControlRequestCallback callback;
+
+        ResultCallback(String action, MediaRouter.ControlRequestCallback callback) {
+            this.action = action;
+            this.callback = callback;
+        }
+
+        @Override
+        public void onResult(CastRemotePlayback.Status status) {
+            final Bundle data = new Bundle();
+            if (status.sessionId != null) {
+                data.putString(MediaControlIntent.EXTRA_SESSION_ID, status.sessionId);
+                data.putBundle(MediaControlIntent.EXTRA_SESSION_STATUS, toSessionStatusBundle(status));
+            }
+            boolean itemAction = MediaControlIntent.ACTION_PLAY.equals(action) || MediaControlIntent.ACTION_SEEK.equals(action)
+                    || MediaControlIntent.ACTION_GET_STATUS.equals(action);
+            if (itemAction && status.itemId != null) {
+                data.putString(MediaControlIntent.EXTRA_ITEM_ID, status.itemId);
+                data.putBundle(MediaControlIntent.EXTRA_ITEM_STATUS, toItemStatusBundle(status));
+            }
+            if (callback == null) return;
+            mainHandler.post(new Runnable() {
+                @Override
+                public void run() {
+                    callback.onResult(data);
+                }
+            });
+        }
+
+        @Override
+        public void onError(final String message, int errorCode) {
+            Log.d(TAG, action + " on " + routeId + " failed: " + message);
+            final Bundle data = new Bundle();
+            data.putInt(MediaControlIntent.EXTRA_ERROR_CODE, errorCode);
+            if (callback == null) return;
+            mainHandler.post(new Runnable() {
+                @Override
+                public void run() {
+                    callback.onError(message, data);
+                }
+            });
+        }
+    }
+
+    private static Bundle toItemStatusBundle(CastRemotePlayback.Status status) {
+        MediaItemStatus.Builder builder = new MediaItemStatus.Builder(status.playbackState)
+                .setTimestamp(SystemClock.elapsedRealtime() - status.positionAge);
+        if (status.contentPosition >= 0) builder.setContentPosition(status.contentPosition);
+        if (status.contentDuration >= 0) builder.setContentDuration(status.contentDuration);
+        return builder.build().asBundle();
+    }
+
+    private static Bundle toSessionStatusBundle(CastRemotePlayback.Status status) {
+        return new MediaSessionStatus.Builder(status.sessionState)
+                .setTimestamp(SystemClock.elapsedRealtime())
+                .build().asBundle();
+    }
+
+    /** Media metadata in the format of the Cast media namespace, from MediaItemMetadata keys. */
+    private static JSONObject toCastMetadata(Bundle metadata, String contentType) {
+        if (metadata == null) return null;
+        String title = metadata.getString(MediaItemMetadata.KEY_TITLE);
+        String artist = metadata.getString(MediaItemMetadata.KEY_ARTIST);
+        if (artist == null) artist = metadata.getString(MediaItemMetadata.KEY_ALBUM_ARTIST);
+        String album = metadata.getString(MediaItemMetadata.KEY_ALBUM_TITLE);
+        String artwork = metadata.getString(MediaItemMetadata.KEY_ARTWORK_URI);
+        try {
+            JSONObject json = new JSONObject();
+            if (contentType != null && contentType.startsWith("audio/")) {
+                json.put("metadataType", 3); // MUSIC_TRACK
+                if (artist != null) json.put("artist", artist);
+                if (album != null) json.put("albumName", album);
+            } else {
+                json.put("metadataType", 0); // GENERIC
+                if (artist != null) json.put("subtitle", artist);
+            }
+            if (title != null) json.put("title", title);
+            if (artwork != null) json.put("images", new JSONArray().put(new JSONObject().put("url", artwork)));
+            return json;
+        } catch (JSONException e) {
+            return null;
+        }
+    }
+
