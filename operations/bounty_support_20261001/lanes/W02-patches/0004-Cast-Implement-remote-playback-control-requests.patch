+
+/**
+ * MediaRouter remote playback (MediaControlIntent.CATEGORY_REMOTE_PLAYBACK) on a Cast receiver, using the Default
+ * Media Receiver and the media namespace.
+ * <p>
+ * One remote playback session with at most one item at a time, like the Default Media Receiver itself. Not thread
+ * safe: every method, including the event methods, must be called on the thread of the executor passed to the
+ * constructor, and callbacks are invoked there.
+ */
+public class CastRemotePlayback {
+    public static final String DEFAULT_MEDIA_RECEIVER_APPLICATION_ID = "CC1AD845";
+    public static final String NAMESPACE_MEDIA = "urn:x-cast:com.google.cast.media";
+
+    static final long REQUEST_TIMEOUT_MILLIS = 10_000;
+    static final long LOAD_TIMEOUT_MILLIS = 30_000;
+
+    /** Access to the receiver connection. Results are reported through the event methods of this class. */
+    public interface Connection {
+        /** Register the media namespace and attach to (launching if needed) the given receiver application. */
+        void launchApplication(String applicationId);
+
+        /** Failures to send are reported through {@link #onSendMessageFailure(long)} with the same request id. */
+        void sendMessage(String namespace, String message, long requestId);
+
+        void stopApplication();
+    }
+
+    public interface Callback {
+        void onResult(Status status);
+
+        /** @param errorCode one of the MediaControlIntent.ERROR_* values */
+        void onError(String message, int errorCode);
+    }
+
+    public interface Listener {
+        /** The session or item status changed without a request, e.g. playback finished or the app was stopped. */
+        void onStatusChanged(Status status);
+    }
+
+    /** Snapshot of the session and item state. */
+    public static class Status {
+        public String sessionId;
+        /** One of the MediaSessionStatus.SESSION_STATE_* values. */
+        public int sessionState;
+        /** Null if no item was played in this session. */
+        public String itemId;
+        /** One of the MediaItemStatus.PLAYBACK_STATE_* values. */
+        public int playbackState;
+        /** Content position in milliseconds, -1 if unknown. */
+        public long contentPosition = -1;
+        /** Content duration in milliseconds, -1 if unknown. */
+        public long contentDuration = -1;
+        /** Milliseconds since the position was reported by the receiver. */
+        public long positionAge;
+
+        @Override
+        public String toString() {
+            return "Status{session=" + sessionId + "/" + sessionState + ", item=" + itemId + "/" + playbackState +
+                    ", position=" + contentPosition + "/" + contentDuration + "}";
+        }
+    }
+
+    private interface ReplyHandler {
+        /** @param reply the receiver's reply, or null on timeout or connection loss */
+        void onReply(JSONObject reply);
+    }
+
+    private enum AppState {NONE, LAUNCHING, READY}
+
+    private final Connection connection;
+    private final ScheduledExecutorService executor;
+    private final Listener listener;
+
+    private int nextSessionId = 1;
+    private int nextItemId = 1;
+    private long nextRequestId = 1;
+
+    private String sessionId;
+    private int sessionState = MediaSessionStatus.SESSION_STATE_ENDED;
+    private String itemId;
+    private int playbackState = MediaItemStatus.PLAYBACK_STATE_PENDING;
+    private long contentPosition = -1;
+    private long contentDuration = -1;
+    private long positionTimeNanos = System.nanoTime();
+    /** The receiver's media session of the current item, -1 if none. */
+    private int mediaSessionId = -1;
+    /** Request id of the LOAD whose reply names the media session of the current item, 0 if none. */
+    private long loadRequestId = 0;
+
+    private AppState appState = AppState.NONE;
+    private final List<Runnable> waitingForApplication = new ArrayList<>();
+    private final List<Callback> waitingCallbacks = new ArrayList<>();
+    private final Map<Long, PendingRequest> pendingRequests = new HashMap<>();
+
+    private static class PendingRequest {
+        final ReplyHandler handler;
+        ScheduledFuture<?> timeout;
+
+        PendingRequest(ReplyHandler handler) {
+            this.handler = handler;
+        }
+    }
+
+    public CastRemotePlayback(Connection connection, ScheduledExecutorService executor, Listener listener) {
+        this.connection = connection;
+        this.executor = executor;
+        this.listener = listener;
+    }
+
+    // MediaRouter requests
+
+    public void startSession(Callback callback) {
+        if (isSessionActive()) {
+            // Only one session at a time: the previous one is replaced.
+            sessionState = MediaSessionStatus.SESSION_STATE_INVALIDATED;
+            notifyStatusChanged();
+            resetItem();
+        }
+        sessionId = Integer.toString(nextSessionId++);
+        sessionState = MediaSessionStatus.SESSION_STATE_ACTIVE;
+        callback.onResult(snapshot());
+    }
+
+    public void getSessionStatus(String requestedSessionId, Callback callback) {
+        if (!isCurrentSession(requestedSessionId)) {
+            callback.onError("Unknown session " + requestedSessionId, MediaControlIntent.ERROR_INVALID_SESSION_ID);
+            return;
+        }
+        callback.onResult(snapshot());
+    }
+
+    public void endSession(String requestedSessionId, final Callback callback) {
+        if (!isCurrentSession(requestedSessionId)) {
+            callback.onError("Unknown session " + requestedSessionId, MediaControlIntent.ERROR_INVALID_SESSION_ID);
+            return;
+        }
+        if (sessionState == MediaSessionStatus.SESSION_STATE_ACTIVE) {
+            sessionState = MediaSessionStatus.SESSION_STATE_ENDED;
+            if (itemId != null && !isFinalPlaybackState(playbackState)) {
+                playbackState = MediaItemStatus.PLAYBACK_STATE_CANCELED;
+            }
+            if (appState != AppState.NONE) {
+                // Stopping the receiver application also ends playback on the device.
+                appState = AppState.NONE;
+                mediaSessionId = -1;
+                failWaiting(MediaControlIntent.ERROR_UNKNOWN, "Session ended");
+                failPendingRequests();
+                connection.stopApplication();
+            }
+        }
+        callback.onResult(snapshot());
+    }
+
+    public void play(final String contentUrl, final String contentType, final JSONObject metadata, final long position,
+                     String requestedSessionId, final Callback callback) {
+        if (requestedSessionId != null && !requestedSessionId.equals(sessionId)) {
+            callback.onError("Unknown session " + requestedSessionId, MediaControlIntent.ERROR_INVALID_SESSION_ID);
+            return;
+        }
+        if (requestedSessionId != null && !isSessionActive()) {
+            callback.onError("Session " + requestedSessionId + " is not active", MediaControlIntent.ERROR_INVALID_SESSION_ID);
+            return;
+        }
+        if (!isSessionActive()) {
+            // Play without a session starts one implicitly.
+            sessionId = Integer.toString(nextSessionId++);
+            sessionState = MediaSessionStatus.SESSION_STATE_ACTIVE;
+        }
+        if (itemId != null && !isFinalPlaybackState(playbackState)) {
+            // The Default Media Receiver plays one item, a new item replaces the current one.
+            playbackState = MediaItemStatus.PLAYBACK_STATE_CANCELED;
+            notifyStatusChanged();
+        }
+        final String newItemId = Integer.toString(nextItemId++);
+        itemId = newItemId;
+        playbackState = MediaItemStatus.PLAYBACK_STATE_PENDING;
+        contentPosition = position > 0 ? position : -1;
+        contentDuration = -1;
+        mediaSessionId = -1;
+        final String playSessionId = sessionId;
+
+        withApplication(callback, new Runnable() {
+            @Override
+            public void run() {
+                if (!newItemId.equals(itemId) || !playSessionId.equals(sessionId)) {
+                    callback.onError("Replaced by another request", MediaControlIntent.ERROR_UNKNOWN);
+                    return;
+                }
+                JSONObject request = new JSONObject();
+                try {
+                    JSONObject media = new JSONObject()
+                            .put("contentId", contentUrl)
+                            .put("contentUrl", contentUrl)
+                            .put("streamType", "BUFFERED")
+                            .put("contentType", contentType != null ? contentType : guessContentType(contentUrl));
+                    if (metadata != null) media.put("metadata", metadata);
+                    request.put("type", "LOAD")
+                            .put("media", media)
+                            .put("autoplay", true)
+                            .put("currentTime", position > 0 ? position / 1000.0 : 0.0);
+                } catch (JSONException e) {
+                    callback.onError("Invalid request", MediaControlIntent.ERROR_UNKNOWN);
+                    return;
+                }
+                loadRequestId = sendMediaRequest(request, LOAD_TIMEOUT_MILLIS, new ReplyHandler() {
+                    @Override
+                    public void onReply(JSONObject reply) {
+                        if (!newItemId.equals(itemId)) {
+                            callback.onError("Replaced by another request", MediaControlIntent.ERROR_UNKNOWN);
+                            return;
+                        }
+                        loadRequestId = 0;
+                        String type = reply == null ? null : reply.optString("type");
+                        if ("MEDIA_STATUS".equals(type) && mediaSessionId != -1) {
+                            callback.onResult(snapshot());
+                        } else {
+                            playbackState = MediaItemStatus.PLAYBACK_STATE_ERROR;
+                            callback.onError(describeFailure("Loading " + contentUrl, reply), MediaControlIntent.ERROR_UNKNOWN);
+                        }
+                    }
+                });
+            }
+        });
+    }
+
+    public void seek(String requestedSessionId, String requestedItemId, long position, Callback callback) {
+        if (!checkItem(requestedSessionId, requestedItemId, callback)) return;
+        try {
+            sendPlayerCommand(new JSONObject().put("type", "SEEK").put("currentTime", Math.max(0, position) / 1000.0), callback);
+        } catch (JSONException e) {
+            callback.onError("Invalid request", MediaControlIntent.ERROR_UNKNOWN);
+        }
+    }
+
+    public void getStatus(String requestedSessionId, String requestedItemId, Callback callback) {
+        if (!checkItem(requestedSessionId, requestedItemId, callback)) return;
+        if (mediaSessionId == -1) {
+            callback.onResult(snapshot());
+            return;
+        }
+        sendPlayerCommand(new JSONObject(), "GET_STATUS", callback);
+    }
+
+    public void pause(String requestedSessionId, Callback callback) {
+        sessionPlayerCommand(requestedSessionId, "PAUSE", callback);
+    }
+
+    public void resume(String requestedSessionId, Callback callback) {
+        sessionPlayerCommand(requestedSessionId, "PLAY", callback);
+    }
+
+    public void stop(String requestedSessionId, Callback callback) {
+        sessionPlayerCommand(requestedSessionId, "STOP", callback);
+    }
+
+    /** End everything without talking to the receiver, e.g. when the route is unselected. */
+    public void release() {
+        failPendingRequests();
+        failWaiting(MediaControlIntent.ERROR_UNKNOWN, "Route released");
+        appState = AppState.NONE;
+        if (isSessionActive()) {
+            sessionState = MediaSessionStatus.SESSION_STATE_INVALIDATED;
+            if (itemId != null && !isFinalPlaybackState(playbackState)) {
+                playbackState = MediaItemStatus.PLAYBACK_STATE_INVALIDATED;
+            }
+            notifyStatusChanged();
+        }
+        mediaSessionId = -1;
+    }
+
+    // Events from the receiver connection
+
+    public void onApplicationConnected(String applicationId) {
+        if (appState != AppState.LAUNCHING) return;
+        if (!DEFAULT_MEDIA_RECEIVER_APPLICATION_ID.equals(applicationId)) {
+            onApplicationConnectionFailed(-1);
+            return;
+        }
+        appState = AppState.READY;
+        List<Runnable> waiting = new ArrayList<>(waitingForApplication);
+        waitingForApplication.clear();
+        waitingCallbacks.clear();
+        for (Runnable runnable : waiting) {
+            runnable.run();
+        }
+    }
+
+    public void onApplicationConnectionFailed(int statusCode) {
+        if (appState != AppState.LAUNCHING) return;
+        appState = AppState.NONE;
+        failWaiting(MediaControlIntent.ERROR_UNKNOWN, "Launching the media receiver failed: " + statusCode);
+    }
+
+    /** The receiver application stopped or the connection to the device was lost. */
+    public void onApplicationDisconnected(int statusCode) {
+        boolean wasLaunching = appState == AppState.LAUNCHING;
+        appState = AppState.NONE;
+        mediaSessionId = -1;
+        failPendingRequests();
+        if (wasLaunching) {
+            failWaiting(MediaControlIntent.ERROR_UNKNOWN, "Connection to the media receiver lost: " + statusCode);
+        }
+        if (isSessionActive()) {
+            // Another sender or the user replaced or stopped the application.
+            sessionState = MediaSessionStatus.SESSION_STATE_INVALIDATED;
+            if (itemId != null && !isFinalPlaybackState(playbackState)) {
+                playbackState = MediaItemStatus.PLAYBACK_STATE_INVALIDATED;
+            }
+            notifyStatusChanged();
+        }
+    }
+
+    /** A media request could not be sent, e.g. because the receiver application is gone. */
+    public void onSendMessageFailure(long requestId) {
+        PendingRequest pending = pendingRequests.remove(requestId);
+        if (pending != null) {
+            if (pending.timeout != null) pending.timeout.cancel(false);
+            pending.handler.onReply(null);
+        }
+    }
+
+    public void onMessage(String namespace, String message) {
+        if (!NAMESPACE_MEDIA.equals(namespace)) return;
+        JSONObject json;
+        try {
+            json = new JSONObject(message);
+        } catch (JSONException e) {
+            return;
+        }
+        boolean changed = false;
+        if ("MEDIA_STATUS".equals(json.optString("type"))) {
+            changed = handleMediaStatus(json);
+        }
+        long requestId = json.optLong("requestId", 0);
+        PendingRequest pending = requestId != 0 ? pendingRequests.remove(requestId) : null;
+        if (pending != null) {
+            if (pending.timeout != null) pending.timeout.cancel(false);
+            pending.handler.onReply(json);
+        } else if (changed) {
+            notifyStatusChanged();
+        }
+    }
+
+    // Internals
+
+    private boolean isSessionActive() {
+        return sessionId != null && sessionState == MediaSessionStatus.SESSION_STATE_ACTIVE;
+    }
+
+    private boolean isCurrentSession(String requestedSessionId) {
+        return requestedSessionId != null && requestedSessionId.equals(sessionId);
+    }
+
+    private static boolean isFinalPlaybackState(int state) {
+        return state == MediaItemStatus.PLAYBACK_STATE_FINISHED || state == MediaItemStatus.PLAYBACK_STATE_CANCELED
+                || state == MediaItemStatus.PLAYBACK_STATE_INVALIDATED || state == MediaItemStatus.PLAYBACK_STATE_ERROR;
+    }
+
+    private void resetItem() {
+        itemId = null;
+        playbackState = MediaItemStatus.PLAYBACK_STATE_PENDING;
+        contentPosition = -1;
+        contentDuration = -1;
+        mediaSessionId = -1;
+    }
+
+    private boolean checkItem(String requestedSessionId, String requestedItemId, Callback callback) {
+        if (!isCurrentSession(requestedSessionId) || !isSessionActive()) {
+            callback.onError("Unknown session " + requestedSessionId, MediaControlIntent.ERROR_INVALID_SESSION_ID);
+            return false;
+        }
+        if (requestedItemId == null || !requestedItemId.equals(itemId)) {
+            callback.onError("Unknown item " + requestedItemId, MediaControlIntent.ERROR_INVALID_ITEM_ID);
+            return false;
+        }
+        return true;
+    }
+
+    private void sessionPlayerCommand(String requestedSessionId, String type, Callback callback) {
+        if (!isCurrentSession(requestedSessionId) || !isSessionActive()) {
+            callback.onError("Unknown session " + requestedSessionId, MediaControlIntent.ERROR_INVALID_SESSION_ID);
+            return;
+        }
+        if (mediaSessionId == -1) {
+            // Nothing is loaded, so there is nothing to pause, resume or stop.
+            callback.onResult(snapshot());
+            return;
+        }
+        sendPlayerCommand(new JSONObject(), type, callback);
+    }
+
+    private void sendPlayerCommand(JSONObject request, String type, Callback callback) {
+        try {
+            request.put("type", type);
+        } catch (JSONException e) {
+            callback.onError("Invalid request", MediaControlIntent.ERROR_UNKNOWN);
+            return;
+        }
+        sendPlayerCommand(request, callback);
+    }
+
+    private void sendPlayerCommand(JSONObject request, final Callback callback) {
+        if (appState != AppState.READY || mediaSessionId == -1) {
+            callback.onError("No media loaded", MediaControlIntent.ERROR_INVALID_ITEM_ID);
+            return;
+        }
+        final String type = request.optString("type");
+        try {
+            request.put("mediaSessionId", mediaSessionId);
+        } catch (JSONException e) {
+            callback.onError("Invalid request", MediaControlIntent.ERROR_UNKNOWN);
+            return;
+        }
+        sendMediaRequest(request, REQUEST_TIMEOUT_MILLIS, new ReplyHandler() {
+            @Override
+            public void onReply(JSONObject reply) {
+                if (reply != null && "MEDIA_STATUS".equals(reply.optString("type"))) {
+                    callback.onResult(snapshot());
+                } else {
+                    callback.onError(describeFailure(type, reply), MediaControlIntent.ERROR_UNKNOWN);
+                }
+            }
+        });
+    }
+
+    /** Run once the Default Media Receiver is attached, launching it if needed. */
+    private void withApplication(Callback callback, Runnable runnable) {
+        if (appState == AppState.READY) {
+            runnable.run();
+            return;
+        }
+        waitingForApplication.add(runnable);
+        waitingCallbacks.add(callback);
+        if (appState == AppState.NONE) {
+            appState = AppState.LAUNCHING;
+            connection.launchApplication(DEFAULT_MEDIA_RECEIVER_APPLICATION_ID);
+        }
+    }
+
+    private void failWaiting(int errorCode, String message) {
+        List<Callback> callbacks = new ArrayList<>(waitingCallbacks);
+        waitingForApplication.clear();
+        waitingCallbacks.clear();
+        for (Callback callback : callbacks) {
+            callback.onError(message, errorCode);
+        }
+    }
+
+    /** @return the request id */
+    private long sendMediaRequest(JSONObject request, long timeoutMillis, ReplyHandler handler) {
+        final long requestId = nextRequestId++;
+        try {
+            request.put("requestId", requestId);
+        } catch (JSONException e) {
+            handler.onReply(null);
+            return requestId;
+        }
+        final PendingRequest pending = new PendingRequest(handler);
+        pendingRequests.put(requestId, pending);
+        try {
+            pending.timeout = executor.schedule(new Runnable() {
+                @Override
+                public void run() {
+                    if (pendingRequests.remove(requestId) == pending) pending.handler.onReply(null);
+                }
+            }, timeoutMillis, TimeUnit.MILLISECONDS);
+        } catch (RejectedExecutionException e) {
+            // Released
+            pendingRequests.remove(requestId);
+            handler.onReply(null);
+            return requestId;
+        }
+        connection.sendMessage(NAMESPACE_MEDIA, request.toString(), requestId);
+        return requestId;
+    }
+
+    private void failPendingRequests() {
+        List<PendingRequest> pending = new ArrayList<>(pendingRequests.values());
+        pendingRequests.clear();
+        for (PendingRequest request : pending) {
+            if (request.timeout != null) request.timeout.cancel(false);
+            request.handler.onReply(null);
+        }
+    }
+
+    /** @return whether the item status changed */
+    private boolean handleMediaStatus(JSONObject json) {
+        if (itemId == null) return false;
+        if (mediaSessionId == -1) {
+            // Only the reply to our LOAD tells which media session belongs to the current item. Other
+            // statuses received meanwhile are about media loaded before.
+            if (loadRequestId == 0 || json.optLong("requestId", 0) != loadRequestId) return false;
+        }
+        JSONArray statuses = json.optJSONArray("status");
+        JSONObject status = null;
+        if (statuses != null) {
+            for (int i = 0; i < statuses.length(); i++) {
+                JSONObject candidate = statuses.optJSONObject(i);
+                if (candidate == null) continue;
+                if (mediaSessionId == -1 || candidate.optInt("mediaSessionId", -1) == mediaSessionId) {
+                    status = candidate;
+                    break;
+                }
+            }
+        }
+        if (status == null && mediaSessionId == -1) return false;
+        int oldState = playbackState;
+        long oldPosition = contentPosition;
+        long oldDuration = contentDuration;
+        if (status == null) {
+            // Our media session is gone without a final state, e.g. after STOP on an older receiver.
+            if (mediaSessionId != -1 && !isFinalPlaybackState(playbackState)) {
+                playbackState = MediaItemStatus.PLAYBACK_STATE_CANCELED;
+                mediaSessionId = -1;
+            }
+        } else {
+            mediaSessionId = status.optInt("mediaSessionId", mediaSessionId);
+            playbackState = toPlaybackState(status.optString("playerState"), status.optString("idleReason"), playbackState);
+            if (status.has("currentTime")) {
+                contentPosition = (long) (status.optDouble("currentTime", 0) * 1000);
+                positionTimeNanos = System.nanoTime();
+            }
+            JSONObject media = status.optJSONObject("media");
+            if (media != null && media.has("duration") && !media.isNull("duration")) {
+                double duration = media.optDouble("duration", -1);
+                contentDuration = duration >= 0 ? (long) (duration * 1000) : -1;
+            }
+            if (isFinalPlaybackState(playbackState)) {
+                // The receiver discards the media session after reporting a final state.
+                mediaSessionId = -1;
+            }
+        }
+        return oldState != playbackState || oldPosition != contentPosition || oldDuration != contentDuration;
+    }
+
+    static int toPlaybackState(String playerState, String idleReason, int current) {
+        switch (playerState) {
+            case "PLAYING":
+                return MediaItemStatus.PLAYBACK_STATE_PLAYING;
+            case "PAUSED":
+                return MediaItemStatus.PLAYBACK_STATE_PAUSED;
+            case "BUFFERING":
+            case "LOADING":
+                return MediaItemStatus.PLAYBACK_STATE_BUFFERING;
+            case "IDLE":
+                switch (idleReason) {
+                    case "FINISHED":
+                        return MediaItemStatus.PLAYBACK_STATE_FINISHED;
+                    case "CANCELLED":
+                        return MediaItemStatus.PLAYBACK_STATE_CANCELED;
+                    case "INTERRUPTED":
+                        return MediaItemStatus.PLAYBACK_STATE_INVALIDATED;
+                    case "ERROR":
+                        return MediaItemStatus.PLAYBACK_STATE_ERROR;
+                    default:
+                        return MediaItemStatus.PLAYBACK_STATE_PENDING;
+                }
+            default:
+                return current;
+        }
+    }
+
+    static String guessContentType(String url) {
+        String path = url.toLowerCase();
+        int query = path.indexOf('?');
+        if (query >= 0) path = path.substring(0, query);
+        if (path.endsWith(".m3u8")) return "application/x-mpegurl";
+        if (path.endsWith(".mpd")) return "application/dash+xml";
+        if (path.endsWith(".mp3")) return "audio/mpeg";
+        if (path.endsWith(".jpg") || path.endsWith(".jpeg")) return "image/jpeg";
+        if (path.endsWith(".png")) return "image/png";
+        if (path.endsWith(".webm")) return "video/webm";
+        return "video/mp4";
+    }
+
+    private static String describeFailure(String what, JSONObject reply) {
+        if (reply == null) return what + " timed out";
+        String reason = reply.optString("reason");
+        return what + " failed: " + reply.optString("type") + (reason.isEmpty() ? "" : " (" + reason + ")");
+    }
+
+    private void notifyStatusChanged() {
+        listener.onStatusChanged(snapshot());
+    }
+
+    Status snapshot() {
+        Status status = new Status();
+        status.sessionId = sessionId;
+        status.sessionState = sessionState;
+        status.itemId = itemId;
+        status.playbackState = playbackState;
+        status.contentPosition = contentPosition;
+        status.contentDuration = contentDuration;
+        status.positionAge = TimeUnit.NANOSECONDS.toMillis(System.nanoTime() - positionTimeNanos);
+        return status;
+    }
+}
