{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woahwhattheheck.github.io/commons/revenue/expertise_catalog/catalog.schema.json",
  "title": "Commons expertise catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "family", "canonical_page", "truth_boundary", "commercial_modes", "formats", "entries"],
  "properties": {
    "schema_version": {"const": "commons-expertise-catalog/v1"},
    "kind": {"const": "EXPERTISE_CATALOG"},
    "family": {"const": "expertise"},
    "canonical_page": {"const": "expertise.html"},
    "truth_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buyer_claimed", "acceptance_claimed", "delivery_claimed", "settlement_claimed", "payout_claimed", "cash_claimed", "rule"],
      "properties": {
        "buyer_claimed": {"const": false},
        "acceptance_claimed": {"const": false},
        "delivery_claimed": {"const": false},
        "settlement_claimed": {"const": false},
        "payout_claimed": {"const": false},
        "cash_claimed": {"const": false},
        "rule": {"type": "string", "minLength": 20}
      }
    },
    "commercial_modes": {"const": ["LIVE_EXISTING_SKU", "QUOTE_ONLY"]},
    "formats": {"const": ["advisory_hour", "written_assessment", "design_review", "embedded_engagement"]},
    "entries": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "repoPath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capability", "title", "summary", "buyer_job", "formats", "inputs", "deliverables", "acceptance", "commercial", "source_evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^expertise-[a-z0-9-]{5,72}$"},
        "capability": {"type": "string", "pattern": "^[a-z0-9_]{5,80}$"},
        "title": {"type": "string", "minLength": 5, "maxLength": 100},
        "summary": {"type": "string", "minLength": 20, "maxLength": 360},
        "buyer_job": {"type": "string", "minLength": 20, "maxLength": 360},
        "formats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["advisory_hour", "written_assessment", "design_review", "embedded_engagement"]}},
        "inputs": {"$ref": "#/$defs/stringList"},
        "deliverables": {"$ref": "#/$defs/stringList"},
        "acceptance": {"$ref": "#/$defs/stringList"},
        "commercial": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "amount_usd", "unit", "checkout_reference", "buyer_route"],
              "properties": {
                "mode": {"const": "LIVE_EXISTING_SKU"},
                "amount_usd": {"type": "string", "pattern": "^[1-9][0-9]*(?:\\.[0-9]{2})$"},
                "unit": {"type": "string", "minLength": 1},
                "checkout_reference": {"$ref": "#/$defs/repoPath"},
                "buyer_route": {"type": "string", "pattern": "^commerce\\.html#[A-Za-z0-9._-]+$"}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "amount_usd", "unit", "checkout_reference", "buyer_route"],
              "properties": {
                "mode": {"const": "QUOTE_ONLY"},
                "amount_usd": {"type": "null"},
                "unit": {"type": "null"},
                "checkout_reference": {"type": "null"},
                "buyer_route": {"type": "string", "pattern": "^mailto:tokenjunkielabs@gmail\\.com\\?subject=[A-Za-z0-9%_-]+(?:%20[A-Za-z0-9%_-]+)*$"}
              }
            }
          ]
        },
        "source_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/repoPath"}}
      }
    }
  }
}
