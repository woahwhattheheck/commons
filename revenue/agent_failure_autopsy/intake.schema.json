{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woahwhattheheck.github.io/commons/revenue/agent_failure_autopsy/intake.schema.json",
  "title": "Agent Failure Autopsy private intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "record_classification",
    "case_id",
    "buyer_ref",
    "failure_sentence",
    "harness_stack",
    "submitted_at",
    "evidence",
    "evidence_assessment",
    "clarification",
    "access_boundary"
  ],
  "properties": {
    "schema_version": {"const": "commons-agent-failure-autopsy-intake/v1"},
    "kind": {"const": "AGENT_FAILURE_AUTOPSY_INTAKE"},
    "record_classification": {"enum": ["BUYER_CASE", "SYNTHETIC_EXAMPLE"]},
    "case_id": {"$ref": "#/$defs/id"},
    "buyer_ref": {"type": "string", "pattern": "^buyer_[a-f0-9]{16,64}$"},
    "failure_sentence": {"type": "string", "minLength": 10, "maxLength": 1000},
    "harness_stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness", "harness_version", "model", "operating_system", "runtime", "tooling"],
      "properties": {
        "harness": {"enum": ["codex", "claude-code", "other-coding-agent"]},
        "harness_version": {"$ref": "#/$defs/nullable_text"},
        "model": {"$ref": "#/$defs/nullable_text"},
        "operating_system": {"$ref": "#/$defs/nullable_text"},
        "runtime": {"$ref": "#/$defs/nullable_text"},
        "tooling": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        }
      }
    },
    "submitted_at": {"$ref": "#/$defs/timestamp"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "kind", "location_ref", "sha256", "redacted", "received_at", "anchors"],
        "properties": {
          "evidence_id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["transcript", "log", "screenshot"]},
          "location_ref": {"type": "string", "pattern": "^(private|example):[A-Za-z0-9._/-]+$", "maxLength": 240},
          "sha256": {"$ref": "#/$defs/sha256"},
          "redacted": {"const": true},
          "received_at": {"$ref": "#/$defs/timestamp"},
          "anchors": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["anchor_id", "description"],
              "properties": {
                "anchor_id": {"$ref": "#/$defs/id"},
                "description": {"type": "string", "minLength": 1, "maxLength": 500}
              }
            }
          }
        }
      }
    },
    "evidence_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "assessed_at", "clock_basis_evidence_ids", "usable_evidence_at", "delivery_due_at", "reasons"],
      "properties": {
        "state": {"enum": ["USABLE", "CLARIFICATION_REQUESTED", "INSUFFICIENT_AFTER_CLARIFICATION"]},
        "assessed_at": {"$ref": "#/$defs/timestamp"},
        "clock_basis_evidence_ids": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "usable_evidence_at": {"$ref": "#/$defs/nullable_timestamp"},
        "delivery_due_at": {"$ref": "#/$defs/nullable_timestamp"},
        "reasons": {
          "type": "array",
          "maxItems": 20,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "clarification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rounds_used", "question", "response_received_at", "response_evidence_ids"],
      "properties": {
        "rounds_used": {"type": "integer", "minimum": 0, "maximum": 1},
        "question": {"$ref": "#/$defs/nullable_text"},
        "response_received_at": {"$ref": "#/$defs/nullable_timestamp"},
        "response_evidence_ids": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "access_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secrets_requested",
        "unredacted_credentials_requested",
        "production_access_requested",
        "repository_access_requested"
      ],
      "properties": {
        "secrets_requested": {"const": false},
        "unredacted_credentials_requested": {"const": false},
        "production_access_requested": {"const": false},
        "repository_access_requested": {"const": false}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,79}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "nullable_timestamp": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/timestamp"}
      ]
    },
    "nullable_text": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 500}
      ]
    }
  }
}
