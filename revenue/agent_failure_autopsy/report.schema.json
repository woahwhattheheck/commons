{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woahwhattheheck.github.io/commons/revenue/agent_failure_autopsy/report.schema.json",
  "title": "Agent Failure Autopsy report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "record_classification",
    "offer_id",
    "case_id",
    "intake_sha256",
    "failure_sentence",
    "harness_summary",
    "disposition",
    "artifact_state",
    "delivery",
    "timeline",
    "failure_chain",
    "causes",
    "fixes",
    "prevention_check",
    "clarification",
    "limitations",
    "operator_time",
    "final_review",
    "refund"
  ],
  "properties": {
    "schema_version": {"const": "commons-agent-failure-autopsy-report/v1"},
    "kind": {"const": "AGENT_FAILURE_AUTOPSY_REPORT"},
    "record_classification": {"enum": ["BUYER_CASE", "SYNTHETIC_EXAMPLE"]},
    "offer_id": {"const": "agent-failure-autopsy-29"},
    "case_id": {"$ref": "#/$defs/id"},
    "intake_sha256": {"$ref": "#/$defs/sha256"},
    "failure_sentence": {"type": "string", "minLength": 10, "maxLength": 1000},
    "harness_summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "disposition": {"enum": ["DIAGNOSIS_DELIVERED", "REFUND_REQUIRED"]},
    "artifact_state": {"enum": ["PEER_DRAFT", "READY_FOR_BUYER", "REFUND_REQUIRED"]},
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clock_started_at", "delivery_due_at", "delivered_at", "within_one_business_day"],
      "properties": {
        "clock_started_at": {"$ref": "#/$defs/nullable_timestamp"},
        "delivery_due_at": {"$ref": "#/$defs/nullable_timestamp"},
        "delivered_at": {"$ref": "#/$defs/timestamp"},
        "within_one_business_day": {"type": "boolean"}
      }
    },
    "timeline": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/observed_item"}
    },
    "failure_chain": {
      "type": "array",
      "maxItems": 50,
      "items": {"$ref": "#/$defs/observed_item"}
    },
    "causes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "contributing"],
      "properties": {
        "primary": {
          "type": "array",
          "maxItems": 10,
          "items": {"$ref": "#/$defs/cause"}
        },
        "contributing": {
          "type": "array",
          "maxItems": 20,
          "items": {"$ref": "#/$defs/cause"}
        }
      }
    },
    "fixes": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fix_id", "target", "addresses_cause_ids", "steps", "evidence_refs", "limits"],
        "properties": {
          "fix_id": {"$ref": "#/$defs/id"},
          "target": {"enum": ["PROMPT", "CONFIG", "CODE"]},
          "addresses_cause_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/id"}
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {"type": "string", "minLength": 1, "maxLength": 1000}
          },
          "evidence_refs": {"$ref": "#/$defs/evidence_refs"},
          "limits": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "prevention_check": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["setup", "replay_steps", "expected_result", "failure_signal", "evidence_refs", "execution_state"],
          "properties": {
            "setup": {"type": "string", "minLength": 1, "maxLength": 1000},
            "replay_steps": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {"type": "string", "minLength": 1, "maxLength": 1000}
            },
            "expected_result": {"type": "string", "minLength": 1, "maxLength": 1000},
            "failure_signal": {"type": "string", "minLength": 1, "maxLength": 1000},
            "evidence_refs": {"$ref": "#/$defs/evidence_refs"},
            "execution_state": {"enum": ["PROPOSED_NOT_RUN", "BUYER_REPORTED_PASS", "BUYER_REPORTED_FAIL"]}
          }
        }
      ]
    },
    "clarification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rounds_used", "question", "response_evidence_refs"],
      "properties": {
        "rounds_used": {"type": "integer", "minimum": 0, "maximum": 1},
        "question": {"$ref": "#/$defs/nullable_text"},
        "response_evidence_refs": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidence_ref"}
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "operator_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement_status",
        "human_review_minutes",
        "automated_draft_minutes",
        "review_ceiling_minutes",
        "ceiling_result"
      ],
      "properties": {
        "measurement_status": {"enum": ["MEASURED", "NOT_MEASURED"]},
        "human_review_minutes": {
          "oneOf": [
            {"type": "null"},
            {"type": "number", "minimum": 0, "maximum": 1440}
          ]
        },
        "automated_draft_minutes": {
          "oneOf": [
            {"type": "null"},
            {"type": "number", "minimum": 0, "maximum": 1440}
          ]
        },
        "review_ceiling_minutes": {"const": 15},
        "ceiling_result": {"enum": ["AT_OR_BELOW", "ABOVE", "NOT_ASSESSED"]}
      }
    },
    "final_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reviewer_ref", "reviewed_at", "evidence_link_check"],
      "properties": {
        "state": {"enum": ["PEER_DRAFT", "HUMAN_REVIEWED"]},
        "reviewer_ref": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^reviewer_[a-f0-9]{16,64}$"}
          ]
        },
        "reviewed_at": {"$ref": "#/$defs/nullable_timestamp"},
        "evidence_link_check": {"type": "boolean"}
      }
    },
    "refund": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "reason", "provider_state", "provider_reference_public"],
      "properties": {
        "required": {"type": "boolean"},
        "reason": {"$ref": "#/$defs/nullable_text"},
        "provider_state": {"enum": ["NOT_APPLICABLE", "REQUIRED_PRIVATE_ACTION", "COMPLETED_PRIVATE"]},
        "provider_reference_public": {"const": null}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,79}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "nullable_timestamp": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/timestamp"}
      ]
    },
    "nullable_text": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 1000}
      ]
    },
    "evidence_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,79}#[A-Za-z0-9][A-Za-z0-9._-]{2,79}$"},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/evidence_ref"}
    },
    "observed_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "statement", "evidence_refs"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 1000},
        "statement": {"type": "string", "minLength": 1, "maxLength": 1000},
        "evidence_refs": {"$ref": "#/$defs/evidence_refs"}
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cause_id", "statement", "confidence", "confidence_rationale", "evidence_refs", "alternatives"],
      "properties": {
        "cause_id": {"$ref": "#/$defs/id"},
        "statement": {"type": "string", "minLength": 1, "maxLength": 1000},
        "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
        "confidence_rationale": {"type": "string", "minLength": 1, "maxLength": 1000},
        "evidence_refs": {"$ref": "#/$defs/evidence_refs"},
        "alternatives": {
          "type": "array",
          "maxItems": 20,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    }
  }
}
