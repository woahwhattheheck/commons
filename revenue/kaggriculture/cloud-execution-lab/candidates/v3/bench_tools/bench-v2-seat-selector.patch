diff --git a/tools/test_seat_selector.py b/tools/test_seat_selector.py
new file mode 100644
index 0000000..b73bf78
--- /dev/null
+++ b/tools/test_seat_selector.py
@@ -0,0 +1,27 @@
+import unittest
+
+import leader_pin
+
+
+class SeatSelectorTests(unittest.TestCase):
+    def test_existing_leader_seat_selector_is_unchanged(self):
+        self.assertEqual(
+            leader_pin.parse_episode_seats("107720626:0,107730410:1"),
+            {(107720626, 0), (107730410, 1)},
+        )
+
+    def test_candidate_seat_selector_inverts_for_leader_pin(self):
+        self.assertEqual(
+            leader_pin.parse_episode_seats(
+                "107720626:0,107730410:1", candidate_seats=True
+            ),
+            {(107720626, 1), (107730410, 0)},
+        )
+
+    def test_invalid_seat_fails_closed(self):
+        with self.assertRaisesRegex(ValueError, "seat must be 0 or 1"):
+            leader_pin.parse_episode_seats("107720626:2", candidate_seats=True)
+
+
+if __name__ == "__main__":
+    unittest.main()
