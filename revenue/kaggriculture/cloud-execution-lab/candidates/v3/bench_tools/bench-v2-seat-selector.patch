+def parse_episode_seats(value, *, candidate_seats=False):
+    """Parse EP:SEAT selectors; optionally convert candidate seats to leader seats."""
+    out = set()
+    for item in value.split(","):
+        episode, seat = (int(x) for x in item.split(":"))
+        if seat not in (0, 1):
+            raise ValueError("seat must be 0 or 1: %s" % item)
+        out.add((episode, 1 - seat if candidate_seats else seat))
+    return out
+
+
 def install(engine):
     orig_init = engine._initialize
     orig_interp = engine.interpreter
