name: TITAN market-carry WHEAT audit — SOL-COMPASS

on:
  push:
    branches:
      - 'sol-compass/titan-market-carry-wheat-audit-20260909-01'
    paths:
      - '.github/workflows/titan-market-carry-wheat-audit-sol-compass.yml'
      - 'revenue/kaggriculture/cloud-execution-lab/evidence/sol_compass_market_carry_wheat_audit.py'
      - 'revenue/kaggriculture/cloud-execution-lab/evidence/run_sol_compass_market_carry_wheat_audit.py'
      - 'revenue/kaggriculture/cloud-execution-lab/evidence/run_sol_compass_market_carry_wheat_audit_v2.py'
      - 'revenue/kaggriculture/cloud-execution-lab/evidence/sol_compass_market_carry_route_lifecycle_finalize.py'
  workflow_dispatch:

permissions:
  contents: read

jobs:
  exact-head-audit:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Check out branch with exact source ancestry
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Verify isolated source binding
        shell: bash
        run: |
          set -euo pipefail
          SOURCE=b6b080a6842107f7e9086f64cb0b2b9c38377696
          git merge-base --is-ancestor "$SOURCE" HEAD
          for path in \
            revenue/kaggriculture/cloud-execution-lab/candidates/v3-market-carry/market_carry.py \
            revenue/kaggriculture/cloud-execution-lab/reference/next-panel/vendor/arlene.py \
            revenue/kaggriculture/cloud-execution-lab/reference/engine/kaggriculture.py \
            revenue/kaggriculture/cloud-execution-lab/mechanics.py \
            revenue/kaggriculture/cloud-execution-lab/scheduler.py \
            revenue/kaggriculture/cloud-execution-lab/frozen_selected.py \
            revenue/kaggriculture/cloud-execution-lab/titan_runtime.py \
            revenue/kaggriculture/cloud-execution-lab/TITAN-CONFIG.json
          do
            test "$(git rev-parse "$SOURCE:$path")" = "$(git rev-parse "HEAD:$path")"
          done
          git diff --exit-code "$SOURCE" -- \
            revenue/kaggriculture/cloud-execution-lab/candidates/v3-market-carry/market_carry.py \
            revenue/kaggriculture/cloud-execution-lab/reference/next-panel/vendor/arlene.py \
            revenue/kaggriculture/cloud-execution-lab/reference/engine/kaggriculture.py \
            revenue/kaggriculture/cloud-execution-lab/mechanics.py \
            revenue/kaggriculture/cloud-execution-lab/scheduler.py \
            revenue/kaggriculture/cloud-execution-lab/frozen_selected.py \
            revenue/kaggriculture/cloud-execution-lab/titan_runtime.py \
            revenue/kaggriculture/cloud-execution-lab/TITAN-CONFIG.json

      - name: Compile and execute exact audit
        shell: bash
        run: |
          set -euo pipefail
          python -m py_compile \
            revenue/kaggriculture/cloud-execution-lab/evidence/sol_compass_market_carry_wheat_audit.py \
            revenue/kaggriculture/cloud-execution-lab/evidence/run_sol_compass_market_carry_wheat_audit.py \
            revenue/kaggriculture/cloud-execution-lab/evidence/run_sol_compass_market_carry_wheat_audit_v2.py \
            revenue/kaggriculture/cloud-execution-lab/evidence/sol_compass_market_carry_route_lifecycle_finalize.py
          python revenue/kaggriculture/cloud-execution-lab/evidence/run_sol_compass_market_carry_wheat_audit_v2.py
          python revenue/kaggriculture/cloud-execution-lab/evidence/sol_compass_market_carry_route_lifecycle_finalize.py

      - name: Enforce disposition and source contracts
        shell: bash
        run: |
          set -euo pipefail
          python - <<'PY'
          import json
          report = json.load(open('WHEAT-AUDIT.json', encoding='utf-8'))
          assert report['source_head'] == 'b6b080a6842107f7e9086f64cb0b2b9c38377696'
          assert report['source_blobs']['scheduler'] == 'a483b24dd72b580d7d8811636b54d2d44f391575'
          assert report['source_blobs']['frozen_selected'] == 'fc7baf5c179818a55037f6a61d92984d81d1a21c'
          assert report['binding_correction']['calculation_engine_unchanged'] is True
          assert report['binding_correction']['max_shop_instances'] == 8
          assert report['schema_alias_correction']['calculation_changed'] is False
          assert report['candidate_legal_carry_universe'] == ['WHEAT']
          assert report['max_wheat_demand'] == 9
          assert report['scan']['feasible_rows']
          hidden = report['hidden_rival_wheat_stress']
          assert hidden['max_actual_supply'] == 100
          assert 7 <= hidden['negative_threshold_min'] <= hidden['negative_threshold_max'] <= 10
          lifecycle = report['route_liquidation']
          assert lifecycle['active_max_age'] == 8
          assert lifecycle['source_head'] == report['source_head']
          assert sum(
              row['residual_attribution_erased_at_cooldown']
              for row in lifecycle['by_quantity'].values()
          ) > 0
          assert not report['disposition']['immediate_liquidation_guaranteed']
          assert not report['disposition']['promotion_ready']
          print('DISPOSITION_SOURCE_AND_LIFECYCLE_CONTRACT_PASS')
          PY

      - name: Publish job summary
        if: always()
        shell: bash
        run: |
          if test -f WHEAT-AUDIT.md; then
            cat WHEAT-AUDIT.md >> "$GITHUB_STEP_SUMMARY"
          else
            printf 'Audit failed before WHEAT-AUDIT.md was produced.\n' >> "$GITHUB_STEP_SUMMARY"
          fi

      - name: Upload exact audit evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: titan-market-carry-wheat-audit-sol-compass
          path: |
            WHEAT-AUDIT.json
            WHEAT-AUDIT.md
          if-no-files-found: warn
          retention-days: 7
