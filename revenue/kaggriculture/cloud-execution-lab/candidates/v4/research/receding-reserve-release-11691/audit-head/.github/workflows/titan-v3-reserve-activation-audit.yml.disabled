name: titan-v3-reserve-activation-audit

on:
  push:
    paths:
      - '.github/workflows/titan-v3-reserve-activation-audit.yml'
      - 'revenue/kaggriculture/cloud-execution-lab/candidates/v3-receding-reserve-release/instrumented_candidate.py'
      - 'revenue/kaggriculture/cloud-execution-lab/candidates/v3-receding-reserve-release/summarize_activation.py'
      - 'revenue/kaggriculture/cloud-execution-lab/candidates/v3-receding-reserve-release/test_activation_audit.py'
      - 'p/sol-bulwark-titan-v3-reserve-activation-audit-20260909-01.md'
  pull_request:
    paths:
      - '.github/workflows/titan-v3-reserve-activation-audit.yml'
      - 'revenue/kaggriculture/cloud-execution-lab/candidates/v3-receding-reserve-release/instrumented_candidate.py'
      - 'revenue/kaggriculture/cloud-execution-lab/candidates/v3-receding-reserve-release/summarize_activation.py'
      - 'revenue/kaggriculture/cloud-execution-lab/candidates/v3-receding-reserve-release/test_activation_audit.py'
      - 'p/sol-bulwark-titan-v3-reserve-activation-audit-20260909-01.md'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ${{ github.workflow }}-${{ github.head_ref || github.ref_name }}
  cancel-in-progress: true

jobs:
  exact-activation-audit:
    runs-on: ubuntu-24.04
    timeout-minutes: 35
    env:
      SEED_START: '2609097301'
      SEED_COUNT: '32'
      TELEMETRY_ROOT: /tmp/titan-v3-reserve-activation-audit
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.event.pull_request.head.sha || github.sha }}
          fetch-depth: 1
          persist-credentials: false

      - name: Bind exact checkout
        shell: bash
        env:
          EXPECTED_HEAD: ${{ github.event.pull_request.head.sha || github.sha }}
        run: |
          set -euo pipefail
          test "$(git rev-parse HEAD)" = "$EXPECTED_HEAD"
          printf '%s\n' "$EXPECTED_HEAD" | tee "$RUNNER_TEMP/exact-head.sha"

      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install pinned official-interpreter dependency
        run: python -m pip install --disable-pip-version-check 'kaggle-environments==1.32.7'

      - name: Run audit contracts and source parse
        working-directory: revenue/kaggriculture/cloud-execution-lab/candidates/v3-receding-reserve-release
        shell: bash
        run: |
          set -euo pipefail
          export PYTHONDONTWRITEBYTECODE=1
          python -m unittest -v test_activation_audit.py
          python -m py_compile instrumented_candidate.py summarize_activation.py test_activation_audit.py

      - name: Run 32-seed paired activation census
        shell: bash
        run: |
          set -euo pipefail
          LAB=revenue/kaggriculture/cloud-execution-lab
          KAG=revenue/kaggriculture
          CASE="$LAB/candidates/v3-receding-reserve-release"
          OUT="$RUNNER_TEMP/reserve-activation-audit"
          rm -rf "$OUT" "$TELEMETRY_ROOT"
          mkdir -p "$OUT" "$TELEMETRY_ROOT"
          for ((offset=0; offset<SEED_COUNT; offset++)); do
            seed=$((SEED_START + offset))
            printf '%s\n' "$seed" > "$TELEMETRY_ROOT/seed-hint.txt"
            python "$KAG/cloud-eval/evaluate.py" \
              --engine-dir "$LAB/reference/engine" \
              --loader "$KAG/20260907-offline-agent/evaluate.py" \
              --candidate "$CASE/control.py::agent" \
              --opponent "arlene=$LAB/runtime/variants/v1/reference/next-panel/vendor/arlene.py::agent" \
              --seeds "$seed" \
              --rng-seed 20260909 \
              --action-timeout 1.0 \
              --startup-timeout 15 \
              --game-timeout 180 \
              --output "$OUT/control-$seed.json"
            python "$KAG/cloud-eval/evaluate.py" \
              --engine-dir "$LAB/reference/engine" \
              --loader "$KAG/20260907-offline-agent/evaluate.py" \
              --candidate "$CASE/instrumented_candidate.py::agent" \
              --opponent "arlene=$LAB/runtime/variants/v1/reference/next-panel/vendor/arlene.py::agent" \
              --seeds "$seed" \
              --rng-seed 20260909 \
              --action-timeout 1.0 \
              --startup-timeout 15 \
              --game-timeout 180 \
              --output "$OUT/candidate-$seed.json"
          done

      - name: Classify exact activation and paired score signal
        id: classify
        if: always()
        shell: bash
        run: |
          set +e
          CASE=revenue/kaggriculture/cloud-execution-lab/candidates/v3-receding-reserve-release
          OUT="$RUNNER_TEMP/reserve-activation-audit"
          python "$CASE/summarize_activation.py" \
            --results "$OUT" \
            --telemetry "$TELEMETRY_ROOT" \
            --seed-start "$SEED_START" \
            --seed-count "$SEED_COUNT" \
            --output "$OUT/ACTIVATION-REPORT.json" \
            --markdown "$OUT/ACTIVATION-REPORT.md" \
            --head "$(git rev-parse HEAD)"
          status=$?
          printf 'exit_code=%s\n' "$status" >> "$GITHUB_OUTPUT"
          exit 0

      - name: Publish readable result
        if: always()
        shell: bash
        run: |
          REPORT="$RUNNER_TEMP/reserve-activation-audit/ACTIVATION-REPORT.md"
          if [[ -f "$REPORT" ]]; then
            cat "$REPORT" >> "$GITHUB_STEP_SUMMARY"
          else
            echo '# Activation audit did not reach classification' >> "$GITHUB_STEP_SUMMARY"
          fi

      - name: Retain exact evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: titan-v3-reserve-activation-audit-${{ github.run_id }}
          path: |
            ${{ runner.temp }}/exact-head.sha
            ${{ runner.temp }}/reserve-activation-audit/
            /tmp/titan-v3-reserve-activation-audit/
          if-no-files-found: error
          retention-days: 30

      - name: Assert checkout stayed clean
        if: always()
        run: git diff --exit-code -- .

      - name: Require an advancing action signal
        if: always()
        shell: bash
        run: test "${{ steps.classify.outputs.exit_code }}" = '0'
