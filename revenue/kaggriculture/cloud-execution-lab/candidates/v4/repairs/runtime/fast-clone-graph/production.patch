         view = FarmView(observation)
         tape = self.tapes[state.plan]
-        action = copy.deepcopy(tape[step])
+        action = _r04_clone_tape_action(tape[step])
         repair_weeds(action, view, state, step)
         subtract_advanced_sales(action, state, step)
