+    maximum = max(1, int(cfg.get("maxMarketOrdersPerTurn", 10)))
+    # The engine stores animals in the shed but cannot SELL them. They still
+    # occupy raw market slots. Recover otherwise omitted product lots in those
+    # inert slots WITHOUT moving any already-executable product SELL: its raw
+    # index determines lockstep quotation against the rival's matching row.
+    products = frozenset(("WHEAT", "CARROT", "TOMATO", "STRAWBERRY", "MELON",
+                          "EGG", "MILK", "WOOL", "FERTILIZER"))
+    prefix = market[:maximum]
+    omitted = iter(row for row in market[maximum:] if row[1] in products)
+    for index, row in enumerate(prefix):
+        if row[1] not in products:
+            replacement = next(omitted, None)
+            if replacement is None:
+                break
+            prefix[index] = replacement
+    return {"farmer": units[0], "hands": units[1:], "market": prefix}
 
 
