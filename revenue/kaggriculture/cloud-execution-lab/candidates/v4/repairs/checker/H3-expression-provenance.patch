     def kind(expr,before=None):
         amap=aliases if before is None else before
         return amap.get(expr.id) if isinstance(expr,ast.Name) else None
+
+    def module_lookup(expr):
+        """Exact globals()/locals() lookup of a protected class name."""
+        def namespace_call(node):
+            return (
+                isinstance(node,ast.Call) and isinstance(node.func,ast.Name)
+                and node.func.id in {'globals','locals'} and not node.args and not node.keywords
+            )
+        if isinstance(expr,ast.Subscript) and namespace_call(expr.value):
+            if isinstance(expr.slice,ast.Constant) and expr.slice.value in {'Features','TitanAgent'}:
+                return expr.slice.value
+        if isinstance(expr,ast.Call) and len(expr.args)==1 and not expr.keywords:
+            if (
+                isinstance(expr.func,ast.Attribute) and expr.func.attr in {'get','__getitem__'}
+                and namespace_call(expr.func.value)
+                and isinstance(expr.args[0],ast.Constant)
+                and expr.args[0].value in {'Features','TitanAgent'}
+            ):
+                return expr.args[0].value
+        return None
+
+    def possible_kinds(expr,before=None):
+        direct=kind(expr,before)
+        if direct in protected_by_kind:
+            return {direct}
+        reflected=module_lookup(expr)
+        if reflected:
+            return {reflected}
+        if isinstance(expr,ast.NamedExpr):
+            return possible_kinds(expr.value,before)
+        if isinstance(expr,ast.IfExp):
+            return possible_kinds(expr.body,before)|possible_kinds(expr.orelse,before)
+        if isinstance(expr,ast.BoolOp):
+            out=set()
+            for value in expr.values:
+                out.update(possible_kinds(value,before))
+            return out
+        if isinstance(expr,ast.Subscript) and isinstance(expr.value,(ast.Tuple,ast.List)):
+            elts=expr.value.elts
+            if isinstance(expr.slice,ast.Constant) and type(expr.slice.value) is int:
+                idx=expr.slice.value
+                if -len(elts)<=idx<len(elts):
+                    return possible_kinds(elts[idx],before)
+                return set()
+            out=set()
+            for item in elts:
+                out.update(possible_kinds(item,before))
+            return out
+        if isinstance(expr,ast.Subscript) and isinstance(expr.value,ast.Dict):
+            if isinstance(expr.slice,ast.Constant):
+                wanted=expr.slice.value
+                for key,value in zip(expr.value.keys,expr.value.values):
+                    if isinstance(key,ast.Constant) and key.value==wanted:
+                        return possible_kinds(value,before)
+                return set()
+            out=set()
+            for value in expr.value.values:
+                out.update(possible_kinds(value,before))
+            return out
+        return set()
