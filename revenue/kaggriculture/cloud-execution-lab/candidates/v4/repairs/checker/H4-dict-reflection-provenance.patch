         if isinstance(expr,ast.Subscript) and isinstance(expr.value,ast.Dict):
+            def dict_lookup_kinds(node,wanted):
+                pairs=list(zip(node.keys,node.values))
+                # With only literal keys Python's result is exact: duplicate
+                # equal keys collapse and the LAST equal key wins.  Equality
+                # is intentional here (e.g. 1 and True collide as dict keys).
+                if all(isinstance(key,ast.Constant) for key,_ in pairs):
+                    for key,value in reversed(pairs):
+                        if key.value==wanted:
+                            return possible_kinds(value,before)
+                    return set()
+
+                # A dynamic key may equal wanted at runtime.  Union only the
+                # protected identities its value may return.  Unknown **maps
+                # are stronger: their selected value is opaque, so fail closed
+                # for either protected object kind.  Literal **{...} remains
+                # recursively auditable.
+                out=set()
+                for key,value in pairs:
+                    if key is None:
+                        if isinstance(value,ast.Dict):
+                            out.update(dict_lookup_kinds(value,wanted))
+                        else:
+                            out.update({'root','feature'})
+                    elif isinstance(key,ast.Constant):
+                        if key.value==wanted:
+                            out.update(possible_kinds(value,before))
+                    else:
+                        out.update(possible_kinds(value,before))
+                return out
