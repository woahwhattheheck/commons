+    # H4: Python dict literals use the LAST equal key.  Earlier safe entries
+    # must not hide a later protected identity.
+    feature_dup_key=ast.parse(
+        'class A:\n def act(self):\n'
+        '  f={0: object(), 0: self.features}[0]\n'
+        '  setattr(f,"r04_x",True)\n'
+    ).body[0].body[0]
+    try: mutation_scan([feature_dup_key],('r04_x',))
+    except SystemExit: pass
+    else: fail('duplicate-dict-key feature alias poison false-passed')
+
+    # Inverse precision guard: a later safe duplicate really overwrites the
+    # earlier protected value and must not be over-tainted.
+    feature_dup_safe=ast.parse(
+        'class A:\n def act(self):\n'
+        '  f={0: self.features, 0: object()}[0]\n'
+        '  setattr(f,"r04_x",True)\n'
+    ).body[0].body[0]
+    req(protected_object_alias_reason(feature_dup_safe,{'features','act'},{'r04_x'}) is None,
+        'last-safe duplicate dict key was over-tainted')
+
+    # Equality, not type identity, controls duplicate dict keys: 1 == True.
