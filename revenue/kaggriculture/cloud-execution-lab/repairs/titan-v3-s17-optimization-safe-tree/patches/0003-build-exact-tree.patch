+def _tree_member(name):
+    """Return a canonical relative POSIX path or reject an unsafe/ambiguous name."""
+    if not isinstance(name, str) or not name or "\\" in name:
+        raise ValueError("unsafe V3 tree member %r" % (name,))
+    relative = PurePosixPath(name)
+    if (
+        relative.is_absolute()
+        or relative.as_posix() != name
+        or any(part in ("", ".", "..") for part in relative.parts)
+    ):
+        raise ValueError("unsafe V3 tree member %r" % (name,))
+    return relative
+
+
+def materialize_tree(files, target):
+    """Publish exactly ``files`` into an absent or empty directory, all-or-nothing.
+
+    A non-empty/file/symlink target is never merged with the candidate. Bytes are
+    staged beside the target, read back, and only then renamed into place so stale
+    modules and partial writes cannot enter a panel tree.
+    """
+    target = Path(target)
+    if not target.name or target.name in (".", ".."):
+        raise ValueError("unsafe V3 tree target %s" % target)
+    target_was_empty = False
+    if target.is_symlink():
+        raise FileExistsError("refusing symlink --tree target %s" % target)
+    if target.exists():
+        if not target.is_dir():
+            raise FileExistsError("refusing non-directory --tree target %s" % target)
+        if any(target.iterdir()):
+            raise FileExistsError("refusing non-empty --tree target %s" % target)
+        target_was_empty = True
+
+    target.parent.mkdir(parents=True, exist_ok=True)
+    stage = Path(tempfile.mkdtemp(prefix=".%s.stage-" % target.name, dir=str(target.parent)))
+    published = False
+    try:
+        expected = {}
+        for name in sorted(files):
+            relative = _tree_member(name)
+            blob = files[name]
+            if not isinstance(blob, bytes):
+                raise TypeError("V3 tree member %s is not bytes" % name)
+            destination = stage.joinpath(*relative.parts)
+            destination.parent.mkdir(parents=True, exist_ok=True)
+            destination.write_bytes(blob)
+            expected[name] = blob
+
+        observed = {
+            path.relative_to(stage).as_posix(): path.read_bytes()
+            for path in sorted(p for p in stage.rglob("*") if p.is_file())
+        }
+        if observed != expected:
+            raise RuntimeError("staged V3 tree differs from requested files")
+
+        if target_was_empty:
+            if target.is_symlink() or not target.is_dir() or any(target.iterdir()):
+                raise FileExistsError("--tree target changed during materialization: %s" % target)
+            target.rmdir()
+        elif target.exists():
+            raise FileExistsError("--tree target appeared during materialization: %s" % target)
+        try:
+            stage.rename(target)
+        except Exception:
+            if target_was_empty and not target.exists():
+                target.mkdir()
+            raise
+        published = True
+    finally:
+        if not published:
+            shutil.rmtree(stage, ignore_errors=True)
+
+
+def verify_check(manifest_data, digest, file_count, source_hashes, recorded, rebuilt):
+    """Fail closed when any advertised package receipt differs from rebuilt bytes."""
+    if manifest_data["archive"]["sha256"] != digest:
+        raise ValueError(
+            "V3-MANIFEST.json archive.sha256 %s != rebuilt %s"
+            % (manifest_data["archive"]["sha256"], digest)
+        )
+    if manifest_data["archive"]["files"] != file_count:
+        raise ValueError("V3-MANIFEST.json archive.files drifted")
+    if manifest_data["overlay"] != source_hashes:
+        raise ValueError("V3-MANIFEST.json overlay hashes drifted")
+    if recorded != rebuilt:
+        raise ValueError("FILES.json drifted")
+
+
