+def _normalized_weights(info: Mapping[str, Any], names: tuple[str, ...]) -> dict[str, float]:
+    raw = info.get("scenario_weights")
+    if not isinstance(raw, Mapping) or tuple(raw) != names:
+        raise ObjectiveScoreError("incumbent scenario_weights do not match scenario grid")
+    weights = {name: _finite_real(raw[name], f"scenario_weights.{name}") for name in names}
+    if any(weight < 0.0 for weight in weights.values()):
+        raise ObjectiveScoreError("scenario weights must be nonnegative")
+    total = sum(weights.values())
+    if total <= 0.0:
+        raise ObjectiveScoreError("scenario weights must have positive mass")
+    tolerance = _tolerance(total, 1.0)
+    if abs(total - 1.0) > tolerance:
+        raise ObjectiveScoreError("scenario weights must already be normalized")
+    return weights
+
+
+def _normalize_selected_info(
+    *,
+    control_info: Mapping[str, Any],
+    candidate_info: Mapping[str, Any],
+    reference_plan: tuple[tuple[int, int], ...],
+    control_plan: tuple[tuple[int, int], ...],
+    candidate_plan: tuple[tuple[int, int], ...],
+    reference: Mapping[str, Mapping[str, Any]],
+    control: Mapping[str, Mapping[str, Any]],
+    candidate: Mapping[str, Mapping[str, Any]],
+) -> dict[str, Any]:
+    """Rebuild an admitted candidate report entirely in the incumbent score domain.
+
+    The λ=0 optimizer's report is intentionally not used as the outward base: its
+    score-derived fields are own-value numbers.  Starting from the λ=1 incumbent
+    preserves every unrelated schema field while each score-bearing field is
+    recomputed from the original scorer for the selected candidate plan.
+    """
+    if set(control_info) != EXPECTED_INFO_KEYS or set(candidate_info) != EXPECTED_INFO_KEYS:
+        raise ObjectiveScoreError("optimizer info schema drift")
+    if _canonical_plan(control_info.get("reference"), "control.info.reference") != reference_plan:
+        raise ObjectiveScoreError("control info reference does not match authored reference")
+    if _canonical_plan(candidate_info.get("reference"), "candidate.info.reference") != reference_plan:
+        raise ObjectiveScoreError("candidate info reference does not match authored reference")
+    if _canonical_plan(control_info.get("plan"), "control.info.plan") != control_plan:
+        raise ObjectiveScoreError("control info plan does not match returned plan")
+    if _canonical_plan(candidate_info.get("plan"), "candidate.info.plan") != candidate_plan:
+        raise ObjectiveScoreError("candidate info plan does not match returned plan")
+    for field in (
+        "item", "quantity", "rival_scenario_quantity", "minimum_now",
+        "plans_evaluated", "acceptance_rule",
+    ):
+        if control_info.get(field) != candidate_info.get(field):
+            raise ObjectiveScoreError(f"optimizer metadata drift at {field}")
+    for field in ("downside_bound", "reference_max_regret", "max_regret", "scenario_regrets"):
+        if control_info.get(field) is not None or candidate_info.get(field) is not None:
+            raise ObjectiveScoreError(f"strict optimizer emitted unexpected {field}")
+    names = tuple(reference)
+    if not names or tuple(control) != names or tuple(candidate) != names:
+        raise ObjectiveScoreError("scenario grids differ during normalization")
+    for label, info in (("control", control_info), ("candidate", candidate_info)):
+        scenarios = info.get("scenarios")
+        if not isinstance(scenarios, Mapping) or tuple(scenarios) != names:
+            raise ObjectiveScoreError(f"{label}.scenarios grid drift")
+    weights = _normalized_weights(control_info, names)
+    candidate_weights = _normalized_weights(candidate_info, names)
+    for name in names:
+        tolerance = _tolerance(weights[name], candidate_weights[name])
+        if abs(weights[name] - candidate_weights[name]) > tolerance:
+            raise ObjectiveScoreError(f"candidate scenario weight drift at {name}")
+    normalized = copy.deepcopy(dict(control_info))
+    normalized["plan"] = list(candidate_plan)
+    normalized_scenarios: dict[str, dict[str, Any]] = {}
+    deltas: list[float] = []
+    for name in names:
+        ref = reference[name]
+        ctl = control[name]
+        cand = candidate[name]
+        # Revalidate the Pareto relation at the schema boundary.  This makes the
+        # normalizer independently fail closed even if a caller bypasses admission.
+        admitted, reason, _metrics = _admit_candidate(
+            reference={name: ref}, control={name: ctl}, candidate={name: cand}
+        )
+        if not admitted:
+            raise ObjectiveScoreError(f"normalization admission mismatch: {reason}")
+        reference_relative_raw = ref["relative_value"]
+        relative_raw = cand["relative_value"]
+        own_receipts_raw = cand["own_receipts"]
+        rival_receipts_raw = cand["rival_receipts"]
+        reference_relative = _finite_real(
+            reference_relative_raw, f"{name}.reference_relative_value"
+        )
+        relative = _finite_real(relative_raw, f"{name}.relative_value")
+        _finite_real(own_receipts_raw, f"{name}.own_receipts")
+        rival_receipts = _finite_real(rival_receipts_raw, f"{name}.rival_receipts")
+        carry_units = cand.get("carry_units")
+        if type(carry_units) is not int or carry_units < 0:
+            raise ObjectiveScoreError(f"{name}.carry_units must be a nonnegative integer")
+        own_value = _finite_real(cand["own_value"], f"{name}.own_value")
+        tolerance = _tolerance(relative, rival_receipts, own_value)
+        if abs((relative + rival_receipts) - own_value) > tolerance:
+            raise ObjectiveScoreError(f"{name}.own/relative/rival identity drift")
+        normalized_scenarios[name] = {
+            "reference_relative_value": reference_relative_raw,
+            "relative_value": relative_raw,
+            "own_receipts": own_receipts_raw,
+            "rival_receipts": rival_receipts_raw,
+            "carry_units": carry_units,
+        }
+        deltas.append(relative - reference_relative)
+    worst = round(min(deltas), 8)
+    tolerance = _tolerance(*deltas)
+    if worst <= tolerance:
+        raise ObjectiveScoreError("normalized strict acceptance is not positive")
+    normalized.update({
+        "scenarios": normalized_scenarios,
+        "worst_relative_gain": worst,
+        "forced_feasibility": False,
+        "feasible": True,
+        "acceptance_rule": "strict",
+        "accepted": True,
+        "acceptance_score": worst,
+        "scenario_weights": weights,
+        "weighted_expected_gain": sum(
+            delta * weights[name] for name, delta in zip(names, deltas)
+        ),
+        "downside_bound": None,
+        "reference_max_regret": None,
+        "max_regret": None,
+        "scenario_regrets": None,
+        "safe_own_score_domain": "true_relative_value",
+    })
+    return normalized
 
 
