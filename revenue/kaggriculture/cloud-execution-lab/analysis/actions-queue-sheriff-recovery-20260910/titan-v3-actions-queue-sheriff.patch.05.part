              out.write(f'- **{key}:** `{data[key]}`\n')
+              out.write('\n### Decision counts\n\n')
+              for key, value in data['counts'].items():
+                  out.write(f'- `{key}`: {value}\n')
+
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: actions-queue-sheriff-${{ github.run_id }}
+          path: ${{ runner.temp }}/actions-queue-sheriff.json
+          if-no-files-found: error
+          retention-days: 14
