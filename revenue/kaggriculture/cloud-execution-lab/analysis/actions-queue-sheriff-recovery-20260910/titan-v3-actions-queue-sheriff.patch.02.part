@@ -0,0 +1,251 @@
+from __future__ import annotations
+
+import datetime as dt
+import io
+import json
+import os
+import tempfile
+import unittest
+from pathlib import Path
+from unittest import mock
+
+from queue_sheriff import (
+    GitHubClient,
+    GitHubHTTPError,
+    OpenPull,
+    Run,
+    SheriffError,
+    classify_runs,
+    main,
+    parse_ids,
+)
+
+UTC = dt.timezone.utc
+NOW = dt.datetime(2026, 9, 10, 19, 30, tzinfo=UTC)
+OLD = NOW - dt.timedelta(hours=2)
+NEW = NOW - dt.timedelta(minutes=5)
+
+
+def run(
+    ident: int,
+    *,
+    event: str = "pull_request",
+    branch: str | None = "feature/a",
+    sha: str = "a" * 40,
+    created: dt.datetime = OLD,
+    pulls: tuple[int, ...] = (),
+    workflow_id: int = 7,
+    name: str = "tests",
+    status: str = "queued",
+) -> Run:
+    return Run(
+        id=ident,
+        name=name,
+        workflow_id=workflow_id,
+        event=event,
+        status=status,
+        head_branch=branch,
+        head_sha=sha,
+        created_at=created,
+        html_url=f"https://example.invalid/runs/{ident}",
+        pull_numbers=pulls,
+    )
+
+
+class ClassifierTests(unittest.TestCase):
+    def classify(self, runs, pulls=(), branches=(), **kwargs):
+        return classify_runs(
+            runs,
+            pulls,
+            set(branches),
+            stale_before=NOW - dt.timedelta(minutes=30),
+            **kwargs,
+        )
+
+    def test_closed_pr_is_cancelled_after_grace(self):
+        [decision] = self.classify([run(1)])
+        self.assertEqual((decision.action, decision.reason), ("cancel", "closed_or_missing_pr"))
+
+    def test_recent_unresolved_pr_is_kept(self):
+        [decision] = self.classify([run(1, created=NEW)])
+        self.assertEqual((decision.action, decision.reason), ("keep", "recent_unresolved_pr"))
+
+    def