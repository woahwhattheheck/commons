diff --git a/.github/scripts/queue_sheriff.py b/.github/scripts/queue_sheriff.py
new file mode 100644
--- /dev/null
+++ b/.github/scripts/queue_sheriff.py
@@ -0,0 +1,455 @@
+#!/usr/bin/env python3
+"""Fail-closed GitHub Actions queue triage for the Commons/TITAN swarm.
+
+The default mode is read-only.  ``--apply`` is required before a cancellation
+request is sent.  The classifier is intentionally conservative:
+
+* current open-PR heads are retained;
+* explicitly protected runs/workflows/branches are retained;
+* queued PR checks whose PR is closed/missing are cancellable only after a
+  grace period;
+* queued checks for superseded open-PR heads are cancellable;
+* queued push runs are cancellable only when their branch has been deleted or
+  a newer queued run exists for the same workflow and branch;
+* manual and repository-dispatch runs are retained.
+
+Every decision is emitted to a deterministic JSON receipt.
+"""
+
+from __future__ import annotations
+
+import argparse
+import dataclasses
+import datetime as dt
+import fnmatch
+import json
+import os
+import sys
+import time
+import urllib.error
+import urllib.parse
+import urllib.request
+from collections import defaultdict
+from pathlib import Path
+from typing import Any, Iterable, Mapping, Sequence
+
+API_VERSION = "2026-03-10"
+PR_EVENTS = frozenset({"pull_request", "pull_request_target"})
+UTC = dt.timezone.utc
+
+
+class SheriffError(RuntimeError):
+    """Raised when the audit cannot prove a safe decision."""
+
+
+class GitHubHTTPError(SheriffError):
+    """A GitHub API response outside the accepted status set."""
+
+    def __init__(self, method: str, url: str, status: int, body: str) -> None:
+        super().__init__(f"GitHub {method} {url} failed: HTTP {status}: {body[:500]}")
+        self.status = status
+        self.body = body
+
+
+@dataclasses.dataclass(frozen=True)
+class OpenPull:
+    number: int
+    head_ref: str
+    head_sha: str
+
+
+@dataclasses.dataclass(frozen=True)
+class Run:
+    id: int
+    name: str
+    workflow_id: int
+    event: str
+    status: str
+    head_branch: str | None
+    head_sha: str
+    created_at: dt.datetime
+    html_url: str
+    pull_numbers: tuple[int, ...]
+
+    @classmethod
+    def from_api(cls, value: Mapping[str, Any]) -> "Run":
+        try:
+            pulls = tuple(
+                int(item["number"])
+                for item in value.get("pull_requests", [])
+                if isinstance(item, Mapping) and "number" in item
+            )
+            return cls(
+                id=int(value["id"]),
+                name=str(value["name"]),
+                workflow_id=int(value["workflow_id"]),
+                event=str(value["event"]),
+                status=str(value["status"]),
+                head_branch=(None if value.get("head_branch") is None else str(value["head_branch"])),
+                head_sha=str(value["head_sha"]),
+                created_at=parse_time(str(value["created_at"])),
+                html_url=str(value.get("html_url", "")),
+                pull_numbers=pulls,
+            )
+        except (KeyError, TypeError, ValueError) as exc:
+            raise SheriffError(f"malformed workflow-run payload: {exc}") from exc
+
+
+@dataclasses.dataclass(frozen=True)
+class Decision:
+    run: Run
+    action: str
+    reason: str
+    matched_pull: int | None = None
+
+    def to_json(self) -> dict[str, Any]:
+        return {
+            "run_id": self.run.id,
+            "action": self.action,
+            "reason": self.reason,
+            "name": self.run.name,
+            "workflow_id": self.run.workflow_id,
+            "event": self.run.event,
+            "status": self.run.status,
+            "head_branch": self.run.head_branch,
+            "head_sha": self.run.head_sha,
+            "created_at": format_time(self.run.created_at),
+            "pull_numbers": list(self.run.pull_numbers),
+            "matched_pull": self.matched_pull,
+            "html_url": self.run.html_url,
+        }
+
+
+def parse_time(text: str) -> dt.datetime:
+    parsed = dt.datetime.fromisoformat(text.replace("Z", "+00:00"))
+    if parsed.tzinfo is None:
+        raise SheriffError(f"timestamp lacks timezone: {text!r}")
+    return parsed.astimezone(UTC)
+
+
+def format_time(value: dt.datetime) -> str:
+    return value.astimezone(UTC).isoformat().replace("+00:00", "Z")
+
+
+def matches_any(value: str | None, patterns: Sequence[str]) -> bool:
+    return value is not None and any(fnmatch.fnmatchcase(value, pattern) for pattern in patterns)
+
+
+def _latest_by_group(runs: Iterable[Run]) -> dict[tuple[int, str, str], Run]:
+    latest: dict[tuple[int, str, str], Run] = {}
+    for run in runs:
+        if not run.head_branch:
+            continue
+        key = (run.workflow_id, run.event, run.head_branch)
+        prior = latest.get(key)
+        if prior is None or (run.created_at, run.id) > (prior.created_at, prior.id):
+            latest[key] = run
+    return latest
+
+
+def classify_runs(
+    runs: Sequence[Run],
+    open_pulls: Sequence[OpenPull],
+    existing_branches: set[str],
+    *,
+    stale_before: dt.datetime,
+    protected_run_ids: set[int] | None = None,
+    protected_workflow_globs: Sequence[str] = (),
+    protected_branch_globs: Sequence[str] = (),
+) -> list[Decision]:
+    """Classify queued runs without mutating remote state."""
+
+    protected_run_ids = protected_run_ids or set()
+    pull_by_number = {pull.number: pull for pull in open_pulls}
+    pulls_by_ref: dict[str, list[OpenPull]] = defaultdict(list)
+    for pull in open_pulls:
+        pulls_by_ref[pull.head_ref].append(pull)
+
+    latest = _latest_by_group(runs)
+    decisions: list[Decision] = []
+
+    for run in sorted(runs, key=lambda item: (item.created_at, item.id)):
+        if run.status != "queued":
+            decisions.append(Decision(run, "keep", "not_queued"))
+            continue
+        if run.id in protected_run_ids:
+            decisions.append(Decision(run, "keep", "explicit_run_protection"))
+            continue
+        if matches_any(run.name, protected_workflow_globs):
+            decisions.append(Decision(run, "keep", "workflow_protection"))
+            continue
+        if matches_any(run.head_branch, protected_branch_globs):
+            decisions.append(Decision(run, "keep", "branch_protection"))
+            continue
+
+        if run.event in PR_EVENTS:
+            candidates = [pull_by_number[number] for number in run.pull_numbers if number in pull_by_number]
+            if not candidates and run.head_branch:
+                candidates = pulls_by_ref.get(run.head_branch, [])
+
+            if len(candidates) > 1:
+                decisions.append(Decision(run, "keep", "ambiguous_open_pr_mapping"))
+                continue
+            if not candidates:
+                reason = "recent_unresolved_pr" if run.created_at > stale_before else "closed_or_missing_pr"
+                action = "kee