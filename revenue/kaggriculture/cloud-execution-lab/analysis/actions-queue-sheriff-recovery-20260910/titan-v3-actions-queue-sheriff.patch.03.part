 test_current_open_pr_head_is_kept_by_number(self):
+        pull = OpenPull(22, "feature/a", "a" * 40)
+        [decision] = self.classify([run(1, pulls=(22,))], [pull], ["feature/a"])
+        self.assertEqual((decision.action, decision.reason, decision.matched_pull),
+                         ("keep", "current_open_pr_head", 22))
+
+    def test_current_open_pr_head_is_kept_by_branch_fallback(self):
+        pull = OpenPull(22, "feature/a", "a" * 40)
+        [decision] = self.classify([run(1)], [pull], ["feature/a"])
+        self.assertEqual((decision.action, decision.reason), ("keep", "current_open_pr_head"))
+
+    def test_superseded_open_pr_head_is_cancelled(self):
+        pull = OpenPull(22, "feature/a", "b" * 40)
+        [decision] = self.classify([run(1, pulls=(22,))], [pull], ["feature/a"])
+        self.assertEqual((decision.action, decision.reason), ("cancel", "superseded_open_pr_head"))
+
+    def test_ambiguous_branch_mapping_fails_closed(self):
+        pulls = [OpenPull(22, "feature/a", "a" * 40), OpenPull(23, "feature/a", "a" * 40)]
+        [decision] = self.classify([run(1)], pulls, ["feature/a"])
+        self.assertEqual((decision.action, decision.reason), ("keep", "ambiguous_open_pr_mapping"))
+
+    def test_deleted_branch_push_is_cancelled_after_grace(self):
+        [decision] = self.classify([run(1, event="push")], branches=[])
+        self.assertEqual((decision.action, decision.reason), ("cancel", "deleted_branch_push"))
+
+    def test_recent_deleted_branch_push_is_kept(self):
+        [decision] = self.classify([run(1, event="push", created=NEW)], branches=[])
+        self.assertEqual((decision.action, decision.reason), ("keep", "recent_deleted_branch_push"))
+
+    def test_live_branch_push_is_kept(self):
+        [decision] = self.classify([run(1, event="push")], branches=["feature/a"])
+        self.assertEqual((decision.action, decision.reason), ("keep", "live_branch_push"))
+
+    def test_older_duplicate_push_is_cancelled_but_newest_is_kept(self):
+        old = run(1, event="push", created=OLD, sha="a" * 40)
+        new = run(2, event="push", created=NOW - dt.timedelta(minutes=1), sha="b" * 40)
+        decisions = self.classify([new, old], branches=["feature/a"])
+        self.assertEqual([(d.run.id, d.action, d.reason) for d in decisions], [
+            (1, "cancel", "superseded_branch_run"),
+            (2, "keep", "live_branch_push"),
+        ])
+
+    def test_manual_dispatch_is_never_inferred_stale(self):
+        [decision] = self.classify([run(1, event="workflow_dispatch")])
+        self.assertEqual((decision.action, decision.reason), ("keep", "manual_or_unclassified_event"))
+
+    def test_explicit_run_protection_wins(self):
+        [decision] = self.classify([run(1)], protected_run_ids={1})
+        self.assertEqual((decision.action, decision.reason), ("keep", "explicit_run_protection"))
+
+    def test_workflow_and_branch_globs_protect(self):
+        decisions = self.classify(
+            [run(1, name="titan-v3-one-tree-land"), run(2, branch="release/v3")],
+            protected_workflow_globs=["*one-tree*"],
+            protected_branch_globs=["release/*"],
+        )
+        self.assertEqual([d.reason for d in decisions], ["workflow_protection", "branch_protection"])
+
+    def test_nonqueued_payload_is_kept(self):
+        [decision] = self.classify([run(1, status="in_progress")])
+        self.assertEqual((decision.action, decision.reason), ("keep", "not_queued"))
+
+    def test_parse_ids_accepts_spaces_and_commas(self):
+        self.assertEqual(parse_ids("1, 2 3"), {1, 2, 3})
+
+    def test_parse_ids_rejects_nonpositive(self):
+        with self.assertRaises(Exception):
+            parse_ids("0")
+
+
+class MainFlowTests(unittest.TestCase):
+    class FakeClient:
+        def __init__(self, runs, *, total=None, status=202, report_path=None):
+            self._runs = list(runs)
+            self._total = len(self._runs) if total is None else total
+            self._status = status
+            self.report_path = report_path
+            self.cancelled = []
+            self.prewrite_snapshots = []
+
+        def open_pulls(self):
+            return []
+
+        def branches(self):
+            return set()
+
+        def queued_runs(self):
+            return list(self._runs), self._total
+
+        def cancel(self, run_id):
+            self.cancelled.append(run_id)
+            if self.report_path is not None:
+                self.prewrite_snapshots.append(json.loads(self.report_path.read_text()))
+            return self._status
+
+    def invoke(self, fake, report, *extra):
+        argv = [
+            '--repository', 'owner/repo',
+            '--token-env', 'TEST_TOKEN',
+            '--report', str(report),
+            '--cancel-delay-seconds', '0',
+            *extra,
+        ]
+        with mock.patch.dict(os.environ, {'TEST_TOKEN': 'test-token'}, clear=False):
+            with mock.patch('queue_sheriff.GitHubClient', return_value=fake):
+                with mock.patch('sys.stdout', new_callable=io.StringIO):
+                    return main(argv)
+
+    def test_dry_run_writes_complete_plan_without_mutation(self):
+        with tempfile.TemporaryDirectory() as temp:
+            report = Path(temp) / 'receipt.json'
+            fake = self.FakeClient([run(1, created=dt.datetime(2000, 1, 1, tzinfo=UTC))], total=1433)
+            self.assertEqual(self.invoke(fake, report), 0)
+            data = json.loads(report.read_text())
+            self.assertEqual(fake.cancelled, [])
+            self.assertEqual(data['mode'], 'dry-run')
+            self.assertEqual(data['selected_for_cancellation'], 1)
+            self.assertTrue(data['api_search_truncated'])
+            self.assertEqual(data['decisions'][0]['reason'], 'closed_or_missing_pr')
+
+    def test_apply_writes_plan_before_cancel_and_respects_oldest_limit(self):
+        with tempfile.TemporaryDirectory() as temp:
+            report = Path(temp) / 'receipt.json'
+            older = run(1, created=dt.datetime(2000, 1, 1, tzinfo=UTC))
+            newer = run(2, created=dt.datetime(2000, 1, 2, tzinfo=UTC))
+            fake = self.FakeClient([newer, older], report_path=report)
+            self.assertEqual(self.invoke(fake, report, '--apply', '--max-cancel', '1'), 0)
+            self.assertEqual(fake.cancelled, [1])
+            self.assertEqual(len(fake.prewrite_snapshots), 1)
+            snapshot = fake.prewrite_snapshots[0]
+            self.assertEqual(snapshot['selected_for_cancellation'], 1)
+            self.assertEqual(snapshot['cancellations'], [])
+            final = json.loads(report.read_text())
+            self.assertEqual(final['cancellations'][0]['outcome'], 'accepted')
+            self.assertEqual(final['cancellable_not_selected'], 1)
+
+    def test_apply_records_cancel_race_without_aborting(self):
+        with tempfile.TemporaryDirectory() as temp:
+            report = Path(temp) / 'receipt.json