p" if run.created_at > stale_before else "cancel"
+                decisions.append(Decision(run, action, reason))
+                continue
+
+            pull = candidates[0]
+            if run.head_sha != pull.head_sha:
+                decisions.append(Decision(run, "cancel", "superseded_open_pr_head", pull.number))
+            else:
+                decisions.append(Decision(run, "keep", "current_open_pr_head", pull.number))
+            continue
+
+        if run.event == "push":
+            if run.head_branch and run.head_branch not in existing_branches:
+                reason = "recent_deleted_branch_push" if run.created_at > stale_before else "deleted_branch_push"
+                action = "keep" if run.created_at > stale_before else "cancel"
+                decisions.append(Decision(run, action, reason))
+                continue
+            if run.head_branch:
+                key = (run.workflow_id, run.event, run.head_branch)
+                newest = latest.get(key)
+                if newest is not None and newest.id != run.id and run.created_at <= stale_before:
+                    decisions.append(Decision(run, "cancel", "superseded_branch_run"))
+                    continue
+            decisions.append(Decision(run, "keep", "live_branch_push"))
+            continue
+
+        decisions.append(Decision(run, "keep", "manual_or_unclassified_event"))
+
+    return decisions
+
+
+class GitHubClient:
+    def __init__(self, repository: str, token: str, *, timeout: float = 30.0) -> None:
+        if repository.count("/") != 1:
+            raise SheriffError("repository must be OWNER/REPO")
+        self.repository = repository
+        self.token = token
+        self.timeout = timeout
+        self.base = f"https://api.github.com/repos/{repository}"
+
+    def _request(self, method: str, url: str) -> tuple[Any, Mapping[str, str], int]:
+        request = urllib.request.Request(
+            url,
+            method=method,
+            headers={
+                "Accept": "application/vnd.github+json",
+                "Authorization": f"Bearer {self.token}",
+                "User-Agent": "commons-titan-queue-sheriff/1",
+                "X-GitHub-Api-Version": API_VERSION,
+            },
+        )
+        try:
+            with urllib.request.urlopen(request, timeout=self.timeout) as response:
+                raw = response.read()
+                payload: Any = None if not raw else json.loads(raw.decode("utf-8"))
+                return payload, dict(response.headers.items()), int(response.status)
+        except urllib.error.HTTPError as exc:
+            body = exc.read().decode("utf-8", errors="replace")
+            raise GitHubHTTPError(method, url, int(exc.code), body) from exc
+        except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as exc:
+            raise SheriffError(f"GitHub {method} {url} failed: {exc}") from exc
+
+    def _paged(self, path: str, *, max_pages: int = 100) -> list[Mapping[str, Any]]:
+        values: list[Mapping[str, Any]] = []
+        for page in range(1, max_pages + 1):
+            separator = "&" if "?" in path else "?"
+            payload, _, _ = self._request("GET", f"{self.base}{path}{separator}per_page=100&page={page}")
+            if not isinstance(payload, list):
+                raise SheriffError(f"expected list for {path}, got {type(payload).__name__}")
+            batch = [item for item in payload if isinstance(item, Mapping)]
+            if len(batch) != len(payload):
+                raise SheriffError(f"non-object entry in paged response for {path}")
+            values.extend(batch)
+            if len(batch) < 100:
+                return values
+        raise SheriffError(f"pagination exceeded {max_pages} pages for {path}")
+
+    def open_pulls(self) -> list[OpenPull]:
+        payload = self._paged("/pulls?state=open", max_pages=100)
+        result: list[OpenPull] = []
+        for item in payload:
+            try:
+                head = item["head"]
+                result.append(OpenPull(int(item["number"]), str(head["ref"]), str(head["sha"])))
+            except (KeyError, TypeError, ValueError) as exc:
+                raise SheriffError(f"malformed open-PR payload: {exc}") from exc
+        return result
+
+    def branches(self) -> set[str]:
+        payload = self._paged("/branches", max_pages=100)
+        try:
+            return {str(item["name"]) for item in payload}
+        except (KeyError, TypeError) as exc:
+            raise SheriffError(f"malformed branch payload: {exc}") from exc
+
+    def queued_runs(self) -> tuple[list[Run], int]:
+        runs_by_id: dict[int, Run] = {}
+        total_count: int | None = None
+        for page in range(1, 11):  # GitHub caps filtered searches at 1,000 rows.
+            path = f"/actions/runs?status=queued&per_page=100&page={page}"
+            payload, _, _ = self._request("GET", f"{self.base}{path}")
+            if not isinstance(payload, Mapping) or not isinstance(payload.get("workflow_runs"), list):
+                raise SheriffError("malformed workflow-runs payload")
+            observed_total = int(payload.get("total_count", 0))
+            if total_count is None:
+                total_count = observed_total
+            batch = [Run.from_api(item) for item in payload["workflow_runs"]]
+            for run in batch:
+                prior = runs_by_id.get(run.id)
+                if prior is not None and prior != run:
+                    raise SheriffError(f"workflow run {run.id} changed during pagination")
+                runs_by_id[run.id] = run
+            if len(batch) < 100:
+                break
+        return list(runs_by_id.values()), int(total_count or 0)
+
+    def cancel(self, run_id: int) -> int:
+        try:
+            _, _, status = self._request("POST", f"{self.base}/actions/runs/{run_id}/cancel")
+        except GitHubHTTPError as exc:
+            # A queued run can start or finish between classification and POST.
+            # GitHub returns 409 in that race; it is terminal for this pass, not
+            # evidence that the classifier was unsafe.
+            if exc.status == 409:
+                return 409
+            raise
+        if status != 202:
+            raise SheriffError(f"unexpected cancellation status for run {run_id}: {status}")
+        return status
+
+
+def parse_ids(text: str) -> set[int]:
+    values: set[int] = set()
+    for token in text.replace(",", " ").split():
+        try:
+            value = int(token)
+        except ValueError as exc:
+            raise SheriffError(f"invalid run id: {token!r}") from exc
+        if value <= 0:
+            raise SheriffError(f"run id must be positive: {value}")
+        values.add(value)
+    return values
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--repository", default=os.environ.get("GITHUB_REPOSITORY",