{
  "schema": "titan.disabled-feature-dominance.rules.v1",
  "rules": [
    {
      "id": "SPATIAL-WEED-OFF-001",
      "description": "Weed continuation must not run when every spatial/weed carrier is disabled.",
      "severity": "error",
      "file": "revenue/kaggriculture/cloud-execution-lab/spatial_tempo.py",
      "class": "SpatialTempo",
      "function": "transform",
      "target": "self._continue_weed",
      "off_world": {
        "self.pathing": false,
        "self.tempo": false,
        "self.weed_continuation": false
      }
    },
    {
      "id": "SPATIAL-CORE-OFF-002",
      "description": "Path/tempo suffix analysis must be unreachable when both core spatial modes are disabled.",
      "severity": "error",
      "file": "revenue/kaggriculture/cloud-execution-lab/spatial_tempo.py",
      "class": "SpatialTempo",
      "function": "transform",
      "target": "self._suffix",
      "off_world": {
        "self.pathing": false,
        "self.tempo": false
      }
    },
    {
      "id": "SPATIAL-IDLE-COLLECT-OFF-003",
