 PRODUCTS = tuple(p for p in m.PRODUCTS if p not in ('WHEAT','FERTILIZER'))
 HORIZON = 8
 MAX_PLANS = 700
 
 
+def ordered_targets(shed, pending, baseline_q):
+    """Keep the full stock domain while restoring inherited intent priority.
+
+    Existing pending keys retain their first-seen order, current baseline SELL
+    keys follow in controller order, and previously unseen stock is appended in
+    the stable product order.  Dict insertion order is the tie-break consumed by
+    both the direct and selected-action scheduler paths.
+    """
+    priority = {}
+    for source in (pending, baseline_q):
+        for item in source:
+            if item in PRODUCTS:
+                priority.setdefault(item, None)
+    for item in PRODUCTS:
+        priority.setdefault(item, None)
+    return {
+        item: max(0, int(shed.get(item, 0)))
+        for item in priority
+        if shed.get(item, 0) > 0
+    }
+
+
