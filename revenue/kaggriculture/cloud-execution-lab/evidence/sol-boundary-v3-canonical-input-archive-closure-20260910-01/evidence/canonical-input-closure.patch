+# SPDX-License-Identifier: Apache-2.0
+"""Predecessor-killing source/archive custody contracts for the signed V3 builder.
+
+Run from candidates/v3:
+    python -m unittest -v source_checks/test_build_v3_closure.py
+    python -O -m unittest -v source_checks/test_build_v3_closure.py
+"""
+from __future__ import annotations
+
+from contextlib import contextmanager
+import hashlib
+import io
+from pathlib import Path
+import sys
+import tarfile
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+import apply_v3  # noqa: E402
+import build_v3  # noqa: E402
+
+
+def archive(entries):
+    """Create a gzip tar from (name, payload, kind) triples."""
+    raw = io.BytesIO()
+    with tarfile.open(fileobj=raw, mode="w:gz") as tar:
+        for name, payload, kind in entries:
+            info = tarfile.TarInfo(name)
+            if kind == "file":
+                payload = bytes(payload)
+                info.size = len(payload)
+                tar.addfile(info, io.BytesIO(payload))
+            elif kind == "dir":
+                info.type = tarfile.DIRTYPE
+                info.size = 0
+                tar.addfile(info)
+            elif kind == "symlink":
+                info.type = tarfile.SYMTYPE
+                info.linkname = str(payload)
+                info.size = 0
+                tar.addfile(info)
+            elif kind == "hardlink":
+                info.type = tarfile.LNKTYPE
+                info.linkname = str(payload)
+                info.size = 0
+                tar.addfile(info)
+            else:
+                raise ValueError(kind)
+    return raw.getvalue()
+
+
+def base_for(blob, files):
+    return {
+        "sha256": hashlib.sha256(blob).hexdigest(),
+        "bytes": len(blob),
+        "files": files,
+    }
+
+
+@contextmanager
+def patched(obj, name, value):
+    old = getattr(obj, name)
+    setattr(obj, name, value)
+    try:
+        yield
+    finally:
+        setattr(obj, name, old)
+
+
+class CanonicalArchiveClosureTests(unittest.TestCase):
+    def test_valid_relative_regular_files_decode_byte_exact(self):
+        blob = archive([
+            ("./", b"", "dir"),
+            ("./main.py", b"print('ok')\n", "file"),
+            ("pkg", b"", "dir"),
+            ("pkg/data.json", b"{}\n", "file"),
+        ])
+        self.assertEqual(
+            build_v3.canonical_archive_files(blob, base_for(blob, 2)),
+            {"main.py": b"print('ok')\n", "pkg/data.json": b"{}\n"},
+        )
+
+    def test_parent_escape_is_rejected_before_filesystem_write(self):
+        unique = "v3-escape-%s.txt" % next(tempfile._get_candidate_names())
+        outside = Path(tempfile.gettempdir()) / unique
+        outside.unlink(missing_ok=True)
+        blob = archive([("../" + unique, b"escape\n", "file")])
+        with tempfile.NamedTemporaryFile(suffix=".tar.gz", delete=False) as handle:
+            handle.write(blob)
+            archive_path = Path(handle.name)
+        try:
+            with patched(build_v3, "manifest", lambda: {"base": base_for(blob, 1)}):
+                with self.assertRaisesRegex(build_v3.V3BuildError, "escapes root"):
+                    build_v3.package_files(archive_path)
+            self.assertFalse(outside.exists())
+        finally:
+            archive_path.unlink(missing_ok=True)
+            outside.unlink(missing_ok=True)
+
+    def test_absolute_and_windows_ambiguous_paths_are_rejected(self):
+        cases = [
+            ("/tmp/absolute.py", "absolute"),
+            ("C:/drive.py", "drive prefix"),
+            ("C:drive.py", "drive prefix"),
+            ("pkg\\windows.py", "not POSIX"),
+            ("pkg//alias.py", "empty path segment"),
+            ("pkg/./alias.py", "non-canonical"),
+            ("pkg/../escape.py", "escapes root"),
+        ]
+        for name, error in cases:
+            with self.subTest(name=name):
+                blob = archive([(name, b"x", "file")])
+                with self.assertRaisesRegex(build_v3.V3BuildError, error):
+                    build_v3.canonical_archive_files(blob, base_for(blob, 1))
+
+    def test_duplicate_normalized_member_is_rejected(self):
+        blob = archive([("main.py", b"first", "file"), ("./main.py", b"second", "file")])
+        with self.assertRaisesRegex(build_v3.V3BuildError, "duplicate normalized member"):
+            build_v3.canonical_archive_files(blob, base_for(blob, 2))
+
+    def test_regular_file_cannot_shadow_descendant(self):
+        for entries in (
+            [("a", b"x", "file"), ("a/b", b"y", "file")],
+            [("a/b", b"y", "file"), ("a", b"x", "file")],
+        ):
+            with self.subTest(entries=[entry[0] for entry in entries]):
+                blob = archive(entries)
+                with self.assertRaisesRegex(build_v3.V3BuildError, "regular file|below a regular file"):
+                    build_v3.canonical_archive_files(blob, base_for(blob, 2))
+
+    def test_links_and_special_aliases_are_rejected(self):
+        for kind in ("symlink", "hardlink"):
+            with self.subTest(kind=kind):
+                blob = archive([("alias", "main.py", kind)])
+                with self.assertRaisesRegex(build_v3.V3BuildError, "special member"):
+                    build_v3.canonical_archive_files(blob, base_for(blob, 0))
+
+    def test_base_sha_byte_count_and_regular_file_count_are_all_bound(self):
+        blob = archive([("main.py", b"x", "file")])
+        bad_sha = dict(base_for(blob, 1), sha256="0" * 64)
+        bad_bytes = dict(base_for(blob, 1), bytes=len(blob) + 1)
+        bad_files = dict(base_for(blob, 2))
+        for base, error in ((bad_sha, "manifest pins"), (bad_bytes, "byte length"), (bad_files, "regular files")):
+            with self.subTest(error=error):
+                with self.assertRaisesRegex(build_v3.V3BuildError, error):
+                    build_v3.canonical_archive_files(blob, base)
+
+
+class ExecutedSourceClosureTests(unittest.TestCase):
+    def test_builder_and_applier_are_both_in_source_receipt(self):
+        shas = build_v3.source_shas()
+        self.assertEqual(shas["build_v3.py"], hashlib.sha256((ROOT / "build_v3.py").read_bytes()).hexdigest())
+        self.assertEqual(shas["apply_v3.py"], hashlib.sha256((ROOT / "apply_v3.py").read_bytes()).hexdigest())
+        check = ROOT / "source_checks/test_build_v3_closure.py"
+        self.assertEqual(shas["source_checks/test_build_v3_closure.py"], hashlib.sha256(check.read_bytes()).hexdigest())
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
