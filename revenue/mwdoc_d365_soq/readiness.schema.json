{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/woahwhattheheck/commons/blob/main/revenue/mwdoc_d365_soq/readiness.schema.json",
  "title": "MWDOC D365 partner qualification readiness packet",
  "type": "object",
  "required": [
    "schema",
    "id",
    "observed_at",
    "source_path",
    "official_sources",
    "schedule",
    "decision",
    "score_weights",
    "mandatory_gate_keys",
    "targets",
    "reference_slots",
    "proposed_subcontract_scope",
    "outreach_draft",
    "rate_sheet",
    "agreement_checklist",
    "truth_flags"
  ],
  "properties": {
    "schema": {
      "const": "commons-mwdoc-d365-readiness/v2"
    },
    "id": {
      "const": "mwdoc-d365-partner-soq-packet-20260902-01"
    },
    "observed_at": {
      "type": "string"
    },
    "source_path": {
      "const": "source.json"
    },
    "official_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "url",
          "observed_on",
          "claim",
          "boundary"
        ]
      }
    },
    "schedule": {
      "type": "object",
      "required": [
        "issued_on",
        "soq_due",
        "attachment_limit_mb",
        "required_content_start",
        "evaluation_start",
        "start_discrepancy_state",
        "addendum_state"
      ]
    },
    "decision": {
      "const": "NO_GO_AS_PRIME; PROVISIONAL_PARTNER_RESEARCH_ONLY; CONDITIONAL_SUBCONTRACTOR_ONLY"
    },
    "score_weights": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number"
      }
    },
    "mandatory_gate_keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "targets": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "company",
          "target_persona",
          "proposed_role",
          "computed_score",
          "max_score",
          "score_percent",
          "mandatory_gates",
          "missing_mandatory_gates",
          "status",
          "evidence_source"
        ],
        "properties": {
          "company": {
            "type": "string"
          },
          "target_persona": {
            "type": "string"
          },
          "proposed_role": {
            "type": "string"
          },
          "computed_score": {
            "type": "number",
            "minimum": 0
          },
          "max_score": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "score_percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "mandatory_gates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "key",
                "state",
                "state_factor",
                "evidenced",
                "source_count"
              ]
            }
          },
          "missing_mandatory_gates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          },
          "evidence_source": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "reference_slots": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "slot",
          "status",
          "public_contact_data",
          "requirements"
        ]
      }
    },
    "proposed_subcontract_scope": {
      "type": "object",
      "required": [
        "label",
        "inclusions",
        "exclusions"
      ]
    },
    "outreach_draft": {
      "type": "object",
      "required": [
        "state",
        "authorization",
        "teaming_claim",
        "target_company",
        "target_persona",
        "subject",
        "body"
      ]
    },
    "rate_sheet": {
      "type": "object",
      "required": [
        "status",
        "currency",
        "rows",
        "assumptions"
      ]
    },
    "agreement_checklist": {
      "type": "object",
      "required": [
        "status",
        "disclaimer",
        "items"
      ]
    },
    "truth_flags": {
      "type": "object",
      "additionalProperties": {
        "const": false
      }
    }
  },
  "additionalProperties": false
}
