from __future__ import annotations

import csv
from contextlib import closing
import hashlib
import io
import json
import re
import sqlite3
from dataclasses import dataclass
from datetime import date, datetime, timezone
from pathlib import Path
from types import MappingProxyType
from typing import Any, Callable, Iterable, Mapping

SCHEMA_VERSION = 1
ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{0,254}$")
MAX_ID_LENGTH = 255
_AUTHORITY_LITERAL = {
    "customer_messaging": False,
    "provider_navigation": False,
    "accounting_mutation": False,
    "payment_mutation": False,
    "deployment": False,
    "revenue_assertion": False,
    "sanitation_certification": False,
    "quality_inference": False,
}
AUTHORITY = MappingProxyType(_AUTHORITY_LITERAL.copy())


class LaundryDeskError(RuntimeError):
    pass


class ValidationError(LaundryDeskError):
    pass


class IdempotencyConflict(LaundryDeskError):
    pass


class StateConflict(LaundryDeskError):
    pass


class InvoiceBlocked(LaundryDeskError):
    pass


def _utc_now() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def _canonical_json(value: Any) -> str:
    _reject_non_json_numbers(value)
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False)


def _reject_non_json_numbers(value: Any) -> None:
    if isinstance(value, float):
        raise ValidationError("floating point values are not admitted")
    if isinstance(value, dict):
        for key, child in value.items():
            if not isinstance(key, str):
                raise ValidationError("object keys must be strings")
            _reject_non_json_numbers(child)
    elif isinstance(value, (list, tuple)):
        for child in value:
            _reject_non_json_numbers(child)
    elif value is not None and not isinstance(value, (str, int, bool)):
        raise ValidationError(f"unsupported value type: {type(value).__name__}")


def _hash_payload(payload: Any) -> str:
    return hashlib.sha256(_canonical_json(payload).encode("utf-8")).hexdigest()


def _ident(value: str, field: str) -> str:
    if not isinstance(value, str) or not ID_RE.fullmatch(value):
        raise ValidationError(f"invalid {field}")
    return value


def _label(value: str, field: str) -> str:
    if not isinstance(value, str):
        raise ValidationError(f"{field} must be text")
    if value != value.strip() or not value or len(value) > 200:
        raise ValidationError(f"invalid {field}")
    if any(ord(ch) < 32 for ch in value):
        raise ValidationError(f"control characters not allowed in {field}")
    return value


def _iso_date(value: str, field: str = "date") -> str:
    if not isinstance(value, str) or len(value) != 10:
        raise ValidationError(f"invalid {field}")
    try:
        parsed = date.fromisoformat(value)
    except ValueError as exc:
        raise ValidationError(f"invalid {field}") from exc
    if parsed.isoformat() != value:
        raise ValidationError(f"invalid {field}")
    return value


def _money(value: int, field: str) -> int:
    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
        raise ValidationError(f"{field} must be a non-negative integer number of cents")
    if value > 10**12:
        raise ValidationError(f"{field} exceeds supported bound")
    return value


def _weekday(value: int) -> int:
    if isinstance(value, bool) or not isinstance(value, int) or value < 0 or value > 6:
        raise ValidationError("weekday must be integer 0..6")
    return value


def _sequence(value: int) -> int:
    if isinstance(value, bool) or not isinstance(value, int) or value < 0 or value > 100000:
        raise ValidationError("sequence must be integer 0..100000")
    return value


def _counts(value: Mapping[str, int], field: str) -> dict[str, int]:
    if not isinstance(value, Mapping) or not value:
        raise ValidationError(f"{field} must be a non-empty mapping")
    out: dict[str, int] = {}
    for item, qty in value.items():
        item_id = _ident(item, f"{field} item")
        if isinstance(qty, bool) or not isinstance(qty, int) or qty < 0 or qty > 10**9:
            raise ValidationError(f"{field} quantities must be non-negative integers")
        out[item_id] = qty
    return dict(sorted(out.items()))


def _containers(values: Iterable[str], field: str) -> list[str]:
    if isinstance(values, (str, bytes)):
        raise ValidationError(f"{field} must be a sequence")
    items = [_ident(v, f"{field} container") for v in values]
    if not items:
        raise ValidationError(f"{field} must contain at least one container")
    if len(items) != len(set(items)):
        raise ValidationError(f"duplicate container in {field}")
    return sorted(items)


def _generated_id(namespace: str, *parts: object) -> str:
    namespace = _ident(namespace, "generated ID namespace")
    text_parts = [str(part) for part in parts]
    candidate = f"{namespace}:" + ":".join(text_parts)
    if len(candidate) <= MAX_ID_LENGTH and ID_RE.fullmatch(candidate):
        return candidate
    digest = hashlib.sha256(
        _canonical_json({"namespace": namespace, "parts": text_parts}).encode("utf-8")
    ).hexdigest()
    bounded = f"{namespace}:sha256:{digest}"
    if len(bounded) > MAX_ID_LENGTH or not ID_RE.fullmatch(bounded):
        raise LaundryDeskError("generated identifier contract violated")
    return bounded


def _csv_safe(value: str) -> str:
    if not isinstance(value, str):
        raise ValidationError("CSV projection text must be text")
    return "'" + value if value.startswith(("=", "+", "-", "@")) else value


def _md_literal(value: str) -> str:
    if not isinstance(value, str):
        raise ValidationError("Markdown projection text must be text")
    entities = {
        "&": "&amp;", "<": "&lt;", ">": "&gt;", "|": "&#124;", "`": "&#96;",
        "\\": "&#92;", "*": "&#42;", "_": "&#95;", "[": "&#91;", "]": "&#93;",
        "#": "&#35;", "!": "&#33;",
    }
    return "".join(entities.get(ch, ch) for ch in value)


def _authority_literal() -> dict[str, bool]:
    # Kept for callers that want a fresh inert value. Semantic methods below use
    # source-literal dictionaries so rebinding this helper cannot widen output.
    return {
        "customer_messaging": False,
        "provider_navigation": False,
        "accounting_mutation": False,
        "payment_mutation": False,
        "deployment": False,
        "revenue_assertion": False,
        "sanitation_certification": False,
        "quality_inference": False,
    }


@dataclass(frozen=True)
class OperationResult:
    value: dict[str, Any]
    replayed: bool


class LaundryDesk:
    """SQLite-backed, offline commercial-laundry route/custody operations desk."""

    def __init__(self, database: str | Path):
        self.database = str(Path(database))
        Path(self.database).parent.mkdir(parents=True, exist_ok=True)
        self._initialize()

    def _connect(self) -> sqlite3.Connection:
        conn = sqlite3.connect(self.database, timeout=8.0, isolation_level=None)
        conn.row_factory = sqlite3.Row
        conn.execute("PRAGMA foreign_keys = ON")
        conn.execute("PRAGMA busy_timeout = 8000")
        conn.execute("PRAGMA journal_mode = WAL")
        conn.execute("PRAGMA synchronous = FULL")
        return conn

    def _initialize(self) -> None:
        with closing(self._connect()) as conn:
            conn.executescript(
                """
                CREATE TABLE IF NOT EXISTS meta (
                    key TEXT PRIMARY KEY,
                    value TEXT NOT NULL
                );
                INSERT OR IGNORE INTO meta(key, value) VALUES ('schema_version', '1');

                CREATE TABLE IF NOT EXISTS customers (
                    customer_id TEXT PRIMARY KEY,
                    name TEXT NOT NULL
                );
                CREATE TABLE IF NOT EXISTS sites (
                    site_id TEXT PRIMARY KEY,
                    customer_id TEXT NOT NULL REFERENCES customers(customer_id),
                    name TEXT NOT NULL
                );
                CREATE TABLE IF NOT EXISTS agreements (
                    agreement_id TEXT PRIMARY KEY,
                    site_id TEXT NOT NULL REFERENCES sites(site_id),
                    item_code TEXT NOT NULL,
                    unit_price_cents INTEGER NOT NULL CHECK(unit_price_cents >= 0),
                    active_from TEXT NOT NULL,
                    active_to TEXT
                );
                CREATE INDEX IF NOT EXISTS agreements_lookup
                    ON agreements(site_id, item_code, active_from, active_to);

                CREATE TABLE IF NOT EXISTS service_plans (
                    plan_id TEXT PRIMARY KEY,
                    site_id TEXT NOT NULL REFERENCES sites(site_id),
                    route_code TEXT NOT NULL,
                    weekday INTEGER NOT NULL CHECK(weekday BETWEEN 0 AND 6),
                    stop_sequence INTEGER NOT NULL CHECK(stop_sequence >= 0),
                    active_from TEXT NOT NULL,
                    active_to TEXT
                );
                CREATE INDEX IF NOT EXISTS service_plans_lookup
                    ON service_plans(weekday, active_from, active_to, route_code, stop_sequence, site_id);

                CREATE TABLE IF NOT EXISTS routes (
                    route_id TEXT PRIMARY KEY,
                    service_date TEXT NOT NULL,
                    route_code TEXT NOT NULL,
                    state TEXT NOT NULL CHECK(state IN ('MANIFESTED','IN_PROGRESS','COMPLETE')),
                    UNIQUE(service_date, route_code)
                );
                CREATE TABLE IF NOT EXISTS stops (
                    stop_id TEXT PRIMARY KEY,
                    route_id TEXT NOT NULL REFERENCES routes(route_id),
                    site_id TEXT NOT NULL REFERENCES sites(site_id),
                    stop_sequence INTEGER NOT NULL,
                    state TEXT NOT NULL CHECK(state IN ('MANIFESTED','PICKED_UP','PROCESSED','DELIVERED','INVOICE_DRAFTED')),
                    UNIQUE(route_id, site_id),
                    UNIQUE(route_id, stop_sequence)
                );

                CREATE TABLE IF NOT EXISTS linen_counts (
                    stop_id TEXT NOT NULL REFERENCES stops(stop_id),
                    phase TEXT NOT NULL CHECK(phase IN ('PICKUP','PROCESSED','DAMAGED','DELIVERED')),
                    item_code TEXT NOT NULL,
                    qty INTEGER NOT NULL CHECK(qty >= 0),
                    PRIMARY KEY(stop_id, phase, item_code)
                );
                CREATE TABLE IF NOT EXISTS container_custody (
                    stop_id TEXT NOT NULL REFERENCES stops(stop_id),
                    phase TEXT NOT NULL CHECK(phase IN ('PICKUP','DELIVERY')),
                    container_id TEXT NOT NULL,
                    PRIMARY KEY(stop_id, phase, container_id)
                );

                CREATE TABLE IF NOT EXISTS exceptions (
                    exception_id TEXT PRIMARY KEY,
                    stop_id TEXT NOT NULL REFERENCES stops(stop_id),
                    kind TEXT NOT NULL,
                    item_code TEXT NOT NULL,
                    expected_qty INTEGER NOT NULL CHECK(expected_qty >= 0),
                    actual_qty INTEGER NOT NULL CHECK(actual_qty >= 0),
                    status TEXT NOT NULL CHECK(status IN ('OPEN','RESOLVED')),
                    resolution_code TEXT,
                    resolution_note TEXT
                );
                CREATE INDEX IF NOT EXISTS exceptions_open
                    ON exceptions(stop_id, status);

                CREATE TABLE IF NOT EXISTS invoices (
                    invoice_id TEXT PRIMARY KEY,
                    stop_id TEXT NOT NULL UNIQUE REFERENCES stops(stop_id),
                    state TEXT NOT NULL CHECK(state = 'DRAFT'),
                    total_cents INTEGER NOT NULL CHECK(total_cents >= 0),
                    payload_json TEXT NOT NULL
                );

                CREATE TABLE IF NOT EXISTS operations (
                    operation_key TEXT PRIMARY KEY,
                    payload_hash TEXT NOT NULL,
                    result_json TEXT NOT NULL
                );
                CREATE TABLE IF NOT EXISTS events (
                    seq INTEGER PRIMARY KEY AUTOINCREMENT,
                    operation_key TEXT NOT NULL UNIQUE REFERENCES operations(operation_key),
                    payload_hash TEXT NOT NULL,
                    event_type TEXT NOT NULL,
                    entity_type TEXT NOT NULL,
                    entity_id TEXT NOT NULL,
                    event_json TEXT NOT NULL,
                    created_at TEXT NOT NULL
                );
                CREATE TRIGGER IF NOT EXISTS events_no_update
                BEFORE UPDATE ON events
                BEGIN SELECT RAISE(ABORT, 'events are immutable'); END;
                CREATE TRIGGER IF NOT EXISTS events_no_delete
                BEFORE DELETE ON events
                BEGIN SELECT RAISE(ABORT, 'events are immutable'); END;
                """
            )
            version = conn.execute("SELECT value FROM meta WHERE key='schema_version'").fetchone()[0]
            if version != str(SCHEMA_VERSION):
                raise LaundryDeskError(f"unsupported schema version {version}")

    def _operation(
        self,
        operation_key: str,
        event_type: str,
        entity_type: str,
        entity_id: str,
        payload: dict[str, Any],
        mutate: Callable[[sqlite3.Connection], dict[str, Any]],
    ) -> OperationResult:
        op_key = _ident(operation_key, "operation_key")
        _ident(event_type, "event_type")
        _ident(entity_type, "entity_type")
        _ident(entity_id, "entity_id")
        payload_hash = _hash_payload(payload)
        conn = self._connect()
        try:
            conn.execute("BEGIN IMMEDIATE")
            prior = conn.execute(
                "SELECT payload_hash, result_json FROM operations WHERE operation_key=?", (op_key,)
            ).fetchone()
            if prior is not None:
                if prior["payload_hash"] != payload_hash:
                    raise IdempotencyConflict("operation key reused with changed content")
                result = json.loads(prior["result_json"])
                conn.commit()
                return OperationResult(result, True)

            result = mutate(conn)
            result_json = _canonical_json(result)
            conn.execute(
                "INSERT INTO operations(operation_key,payload_hash,result_json) VALUES (?,?,?)",
                (op_key, payload_hash, result_json),
            )
            event_json = _canonical_json({"input": payload, "result": result})
            conn.execute(
                "INSERT INTO events(operation_key,payload_hash,event_type,entity_type,entity_id,event_json,created_at) "
                "VALUES (?,?,?,?,?,?,?)",
                (op_key, payload_hash, event_type, entity_type, entity_id, event_json, _utc_now()),
            )
            conn.commit()
            return OperationResult(result, False)
        except Exception:
            conn.rollback()
            raise
        finally:
            conn.close()

    def add_customer(self, operation_key: str, customer_id: str, name: str) -> OperationResult:
        customer_id = _ident(customer_id, "customer_id")
        name = _label(name, "customer name")
        payload = {"customer_id": customer_id, "name": name}

        def mutate(conn: sqlite3.Connection) -> dict[str, Any]:
            if conn.execute("SELECT 1 FROM customers WHERE customer_id=?", (customer_id,)).fetchone():
                raise StateConflict("customer already exists")
            conn.execute("INSERT INTO customers(customer_id,name) VALUES (?,?)", (customer_id, name))
            return {"customer_id": customer_id, "name": name}

        return self._operation(operation_key, "CUSTOMER_CREATED", "customer", customer_id, payload, mutate)

    def add_site(self, operation_key: str, site_id: str, customer_id: str, name: str) -> OperationResult:
        site_id = _ident(site_id, "site_id")
        customer_id = _ident(customer_id, "customer_id")
        name = _label(name, "site name")
        payload = {"site_id": site_id, "customer_id": customer_id, "name": name}

        def mutate(conn: sqlite3.Connection) -> dict[str, Any]:
            if not conn.execute("SELECT 1 FROM customers WHERE customer_id=?", (customer_id,)).fetchone():
                raise ValidationError("unknown customer")
            if conn.execute("SELECT 1 FROM sites WHERE site_id=?", (site_id,)).fetchone():
                raise StateConflict("site already exists")
            conn.execute("INSERT INTO sites(site_id,customer_id,name) VALUES (?,?,?)", (site_id, customer_id, name))
            return payload.copy()

        return self._operation(operation_key, "SITE_CREATED", "site", site_id, payload, mutate)

    def add_agreement(
        self,
        operation_key: str,
        agreement_id: str,
        site_id: str,
        item_code: str,
        unit_price_cents: int,
        active_from: str,
        active_to: str | None = None,
    ) -> OperationResult:
        agreement_id = _ident(agreement_id, "agreement_id")
        site_id = _ident(site_id, "site_id")
        item_code = _ident(item_code, "item_code")
        unit_price_cents = _money(unit_price_cents, "unit_price_cents")
        active_from = _iso_date(active_from, "active_from")
        if active_to is not None:
            active_to = _iso_date(active_to, "active_to")
            if active_to < active_from:
                raise ValidationError("active_to precedes active_from")
        payload = {
            "agreement_id": agreement_id,
            "site_id": site_id,
            "item_code": item_code,
            "unit_price_cents": unit_price_cents,
            "active_from": active_from,
            "active_to": active_to,
        }

        def mutate(conn: sqlite3.Connection) -> dict[str, Any]:
            if not conn.execute("SELECT 1 FROM sites WHERE site_id=?", (site_id,)).fetchone():
                raise ValidationError("unknown site")
            if conn.execute("SELECT 1 FROM agreements WHERE agreement_id=?", (agreement_id,)).fetchone():
                raise StateConflict("agreement already exists")
            rows = conn.execute(
                "SELECT active_from,active_to FROM agreements WHERE site_id=? AND item_code=?",
                (site_id, item_code),
            ).fetchall()
            for row in rows:
                old_start = row["active_from"]
                old_end = row["active_to"] or "9999-12-31"
                new_end = active_to or "9999-12-31"
                if active_from <= old_end and old_start <= new_end:
                    raise StateConflict("agreement date range overlaps existing authority")
            conn.execute(
                "INSERT INTO agreements(agreement_id,site_id,item_code,unit_price_cents,active_from,active_to) VALUES (?,?,?,?,?,?)",
                (agreement_id, site_id, item_code, unit_price_cents, active_from, active_to),
            )
            return payload.copy()

        return self._operation(operation_key, "AGREEMENT_CREATED", "agreement", agreement_id, payload, mutate)

    def add_service_plan(
        self,
        operation_key: str,
        plan_id: str,
        site_id: str,
        route_code: str,
        weekday: int,
        stop_sequence: int,
        active_from: str,
        active_to: str | None = None,
    ) -> OperationResult:
        plan_id = _ident(plan_id, "plan_id")
        site_id = _ident(site_id, "site_id")
        route_code = _ident(route_code, "route_code")
        weekday = _weekday(weekday)
        stop_sequence = _sequence(stop_sequence)
        active_from = _iso_date(active_from, "active_from")
        if active_to is not None:
            active_to = _iso_date(active_to, "active_to")
            if active_to < active_from:
                raise ValidationError("active_to precedes active_from")
        payload = {
            "plan_id": plan_id,
            "site_id": site_id,
            "route_code": route_code,
            "weekday": weekday,
            "stop_sequence": stop_sequence,
            "active_from": active_from,
            "active_to": active_to,
        }

        def mutate(conn: sqlite3.Connection) -> dict[str, Any]:
            if not conn.execute("SELECT 1 FROM sites WHERE site_id=?", (site_id,)).fetchone():
                raise ValidationError("unknown site")
            if conn.execute("SELECT 1 FROM service_plans WHERE plan_id=?", (plan_id,)).fetchone():
                raise StateConflict("service plan already exists")
            conflict = conn.execute(
                "SELECT 1 FROM service_plans WHERE route_code=? AND weekday=? AND stop_sequence=? "
                "AND active_from <= ? AND COALESCE(active_to,'9999-12-31') >= ?",
                (route_code, weekday, stop_sequence, active_to or "9999-12-31", active_from),
            ).fetchone()
            if conflict:
                raise StateConflict("route sequence overlaps an existing active service plan")
            conn.execute(
                "INSERT INTO service_plans(plan_id,site_id,route_code,weekday,stop_sequence,active_from,active_to) VALUES (?,?,?,?,?,?,?)",
                (plan_id, site_id, route_code, weekday, stop_sequence, active_from, active_to),
            )
            return payload.copy()

        return self._operation(operation_key, "SERVICE_PLAN_CREATED", "service_plan", plan_id, payload, mutate)

    def create_daily_route(self, operation_key: str, service_date: str, route_code: str) -> OperationResult:
        service_date = _iso_date(service_date, "service_date")
        route_code = _ident(route_code, "route_code")
        route_id = _generated_id("route", service_date, route_code)
        weekday = date.fromisoformat(service_date).weekday()
        payload = {"service_date": service_date, "route_code": route_code}

        def mutate(conn: sqlite3.Connection) -> dict[str, Any]:
            if conn.execute("SELECT 1 FROM routes WHERE route_id=?", (route_id,)).fetchone():
                raise StateConflict("route already exists")
            plans = conn.execute(
                "SELECT plan_id,site_id,stop_sequence FROM service_plans "
                "WHERE route_code=? AND weekday=? AND active_from<=? "
                "AND (active_to IS NULL OR active_to>=?) "
                "ORDER BY stop_sequence, site_id, plan_id",
                (route_code, weekday, service_date, service_date),
            ).fetchall()
            if not plans:
                raise ValidationError("no active service plans for route/date")
            conn.execute(
                "INSERT INTO routes(route_id,service_date,route_code,state) VALUES (?,?,?,'MANIFESTED')",
                (route_id, service_date, route_code),
            )
            stops: list[dict[str, Any]] = []
            for row in plans:
                stop_id = _generated_id(
                    "stop", service_date, route_code, f"{row['stop_sequence']:04d}", row["site_id"]
                )
                conn.execute(
                    "INSERT INTO stops(stop_id,route_id,site_id,stop_sequence,state) VALUES (?,?,?,?,'MANIFESTED')",
                    (stop_id, route_id, row["site_id"], row["stop_sequence"]),
                )
                stops.append({"stop_id": stop_id, "site_id": row["site_id"], "sequence": row["stop_sequence"]})
            return {"route_id": route_id, "service_date": service_date, "route_code": route_code, "stops": stops}

        return self._operation(operation_key, "ROUTE_MANIFESTED", "route", route_id, payload, mutate)

    @staticmethod
    def _active_container_owner(
        conn: sqlite3.Connection, container_id: str, excluding_stop_id: str
    ) -> str | None:
        row = conn.execute(
            "SELECT cc.stop_id FROM container_custody cc "
            "JOIN stops s ON s.stop_id=cc.stop_id "
            "WHERE cc.phase='PICKUP' AND cc.container_id=? AND cc.stop_id<>? AND ("
            "s.state IN ('PICKED_UP','PROCESSED') OR ("
            "s.state IN ('DELIVERED','INVOICE_DRAFTED') AND EXISTS ("
            "SELECT 1 FROM exceptions e WHERE e.stop_id=cc.stop_id "
            "AND e.kind='CUSTODY_MISSING' AND e.item_code=cc.container_id AND e.status='OPEN'"
            "))) ORDER BY cc.stop_id LIMIT 1",
            (container_id, excluding_stop_id),
        ).fetchone()
        return row["stop_id"] if row else None

    def pickup(
        self,
        operation_key: str,
        stop_id: str,
        linen_counts: Mapping[str, int],
        container_ids: Iterable[str],
    ) -> OperationResult:
        stop_id = _ident(stop_id, "stop_id")
        counts = _counts(linen_counts, "pickup counts")
        containers = _containers(container_ids, "pickup containers")
        payload = {"stop_id": stop_id, "linen_counts": counts, "container_ids": containers}

        def mutate(conn: sqlite3.Connection) -> dict[str, Any]:
            row = conn.execute("SELECT route_id,state FROM stops WHERE stop_id=?", (stop_id,)).fetchone()
            if not row:
                raise ValidationError("unknown stop")
            if row["state"] != "MANIFESTED":
                raise StateConflict("pickup requires MANIFESTED stop")
            for container_id in containers:
                if self._active_container_owner(conn, container_id, stop_id) is not None:
                    raise StateConflict("pickup container already has another active stop owner")
            for item, qty in counts.items():
                conn.execute(
                    "INSERT INTO linen_counts(stop_id,phase,item_code,qty) VALUES (?,?,?,?)",
                    (stop_id, "PICKUP", item, qty),
                )
            for container_id in containers:
                conn.execute(
                    "INSERT INTO container_custody(stop_id,phase,container_id) VALUES (?,?,?)",
                    (stop_id, "PICKUP", container_id),
                )
            conn.execute(
                "UPDATE stops SET state='PICKED_UP' WHERE stop_id=? AND state='MANIFESTED'", (stop_id,)
            )
            conn.execute(
                "UPDATE routes SET state='IN_PROGRESS' WHERE route_id=? AND state='MANIFESTED'", (row["route_id"],)
            )
            return {"stop_id": stop_id, "state": "PICKED_UP", "pickup_counts": counts, "containers": containers}

        return self._operation(operation_key, "PICKUP_RECORDED", "stop", stop_id, payload, mutate)

    def process(
        self,
        operation_key: str,
        stop_id: str,
        processed_counts: Mapping[str, int],
        damaged_counts: Mapping[str, int] | None = None,
    ) -> OperationResult:
        stop_id = _ident(stop_id, "stop_id")
        processed = _counts(processed_counts, "processed counts")
        damaged = _counts(damaged_counts or {item: 0 for item in processed}, "damaged counts")
        payload = {"stop_id": stop_id, "processed_counts": processed, "damaged_counts": damaged}

        def mutate(conn: sqlite3.Connection) -> dict[str, Any]:
            row = conn.execute("SELECT state FROM stops WHERE stop_id=?", (stop_id,)).fetchone()
            if not row:
                raise ValidationError("unknown stop")
            if row["state"] != "PICKED_UP":
                raise StateConflict("processing requires PICKED_UP stop")
            pickup = self._phase_counts(conn, stop_id, "PICKUP")
            item_codes = sorted(set(pickup) | set(processed) | set(damaged))
            created: list[str] = []
            for item in item_codes:
                p = pickup.get(item, 0)
                good = processed.get(item, 0)
                bad = damaged.get(item, 0)
                conn.execute(
                    "INSERT INTO linen_counts(stop_id,phase,item_code,qty) VALUES (?,?,?,?)",
                    (stop_id, "PROCESSED", item, good),
                )
                conn.execute(
                    "INSERT INTO linen_counts(stop_id,phase,item_code,qty) VALUES (?,?,?,?)",
                    (stop_id, "DAMAGED", item, bad),
                )
                if good + bad != p:
                    created.append(self._insert_exception(conn, stop_id, "PROCESS_COUNT_MISMATCH", item, p, good + bad))
                if bad > 0:
                    created.append(self._insert_exception(conn, stop_id, "DAMAGE", item, 0, bad))
            conn.execute(
                "UPDATE stops SET state='PROCESSED' WHERE stop_id=? AND state='PICKED_UP'", (stop_id,)
            )
            return {
                "stop_id": stop_id,
                "state": "PROCESSED",
                "processed_counts": processed,
                "damaged_counts": damaged,
                "open_exception_ids": created,
            }

        return self._operation(operation_key, "PROCESSING_RECORDED", "stop", stop_id, payload, mutate)

    def deliver(
        self,
        operation_key: str,
        stop_id: str,
        delivered_counts: Mapping[str, int],
        container_ids: Iterable[str],
    ) -> OperationResult:
        stop_id = _ident(stop_id, "stop_id")
        delivered = _counts(delivered_counts, "delivered counts")
        containers = _containers(container_ids, "delivery containers")
        payload = {"stop_id": stop_id, "delivered_counts": delivered, "container_ids": containers}

        def mutate(conn: sqlite3.Connection) -> dict[str, Any]:
            row = conn.execute("SELECT route_id,state FROM stops WHERE stop_id=?", (stop_id,)).fetchone()
            if not row:
                raise ValidationError("unknown stop")
            if row["state"] != "PROCESSED":
                raise StateConflict("delivery requires PROCESSED stop")
            for container_id in containers:
                if self._active_container_owner(conn, container_id, stop_id) is not None:
                    raise StateConflict("delivery container still belongs to another active stop")

            processed = self._phase_counts(conn, stop_id, "PROCESSED")
            item_codes = sorted(set(processed) | set(delivered))
            created: list[str] = []
            for item in item_codes:
                expected = processed.get(item, 0)
                actual = delivered.get(item, 0)
                conn.execute(
                    "INSERT INTO linen_counts(stop_id,phase,item_code,qty) VALUES (?,?,?,?)",
                    (stop_id, "DELIVERED", item, actual),
                )
                if actual != expected:
                    created.append(self._insert_exception(conn, stop_id, "DELIVERY_COUNT_MISMATCH", item, expected, actual))

            pickup_containers = {
                r[0]
                for r in conn.execute(
                    "SELECT container_id FROM container_custody WHERE stop_id=? AND phase='PICKUP' ORDER BY container_id",
                    (stop_id,),
                )
            }
            delivery_containers = set(containers)
            for container_id in sorted(pickup_containers - delivery_containers):
                created.append(self._insert_exception(conn, stop_id, "CUSTODY_MISSING", container_id, 1, 0))
            for container_id in sorted(delivery_containers - pickup_containers):
                created.append(self._insert_exception(conn, stop_id, "CUSTODY_UNEXPECTED", container_id, 0, 1))
            for container_id in containers:
                conn.execute(
                    "INSERT INTO container_custody(stop_id,phase,container_id) VALUES (?,?,?)",
                    (stop_id, "DELIVERY", container_id),
                )
            conn.execute(
                "UPDATE stops SET state='DELIVERED' WHERE stop_id=? AND state='PROCESSED'", (stop_id,)
            )
            self._maybe_complete_route(conn, row["route_id"])
            return {
                "stop_id": stop_id,
                "state": "DELIVERED",
                "delivered_counts": delivered,
                "containers": containers,
                "open_exception_ids": created,
            }

        return self._operation(operation_key, "DELIVERY_RECORDED", "stop", stop_id, payload, mutate)

    def resolve_exception(
        self,
        operation_key: str,
        exception_id: str,
        resolution_code: str,
        note: str,
    ) -> OperationResult:
        exception_id = _ident(exception_id, "exception_id")
        resolution_code = _ident(resolution_code, "resolution_code")
        note = _label(note, "resolution note")
        payload = {"exception_id": exception_id, "resolution_code": resolution_code, "note": note}

        def mutate(conn: sqlite3.Connection) -> dict[str, Any]:
            row = conn.execute("SELECT stop_id,status FROM exceptions WHERE exception_id=?", (exception_id,)).fetchone()
            if not row:
                raise ValidationError("unknown exception")
            if row["status"] != "OPEN":
                raise StateConflict("exception already resolved")
            changed = conn.execute(
                "UPDATE exceptions SET status='RESOLVED',resolution_code=?,resolution_note=? WHERE exception_id=? AND status='OPEN'",
                (resolution_code, note, exception_id),
            ).rowcount
            if changed != 1:
                raise StateConflict("exception resolution lost a concurrent terminal race")
            return {
                "exception_id": exception_id,
                "stop_id": row["stop_id"],
                "status": "RESOLVED",
                "resolution_code": resolution_code,
                "note": note,
            }

        return self._operation(operation_key, "EXCEPTION_RESOLVED", "exception", exception_id, payload, mutate)

    def draft_invoice(self, operation_key: str, stop_id: str) -> OperationResult:
        stop_id = _ident(stop_id, "stop_id")
        invoice_id = _generated_id("draft", stop_id)
        payload = {"stop_id": stop_id}

        def mutate(conn: sqlite3.Connection) -> dict[str, Any]:
            row = conn.execute(
                "SELECT s.state,s.site_id,r.service_date,r.route_id FROM stops s "
                "JOIN routes r ON r.route_id=s.route_id WHERE s.stop_id=?", (stop_id,)
            ).fetchone()
            if not row:
                raise ValidationError("unknown stop")
            if row["state"] != "DELIVERED":
                raise StateConflict("invoice draft requires DELIVERED stop")
            if conn.execute("SELECT 1 FROM invoices WHERE stop_id=?", (stop_id,)).fetchone():
                raise StateConflict("invoice draft already exists")
            open_ex = conn.execute(
                "SELECT COUNT(*) FROM exceptions WHERE stop_id=? AND status='OPEN'", (stop_id,)
            ).fetchone()[0]
            if open_ex:
                raise InvoiceBlocked(f"{open_ex} unresolved custody/count exceptions block invoice readiness")
            delivered = self._phase_counts(conn, stop_id, "DELIVERED")
            lines: list[dict[str, Any]] = []
            total = 0
            for item, qty in sorted(delivered.items()):
                auth = conn.execute(
                    "SELECT agreement_id,unit_price_cents FROM agreements WHERE site_id=? AND item_code=? "
                    "AND active_from<=? AND (active_to IS NULL OR active_to>=?) "
                    "ORDER BY active_from DESC,agreement_id",
                    (row["site_id"], item, row["service_date"], row["service_date"]),
                ).fetchall()
                if len(auth) != 1:
                    raise InvoiceBlocked(f"expected exactly one active price authority for {item}; found {len(auth)}")
                cents = _money(auth[0]["unit_price_cents"], "stored unit_price_cents")
                line_total = _money(qty * cents, "line total")
                total = _money(total + line_total, "invoice total")
                lines.append({
                    "item_code": item,
                    "quantity": qty,
                    "unit_price_cents": cents,
                    "line_total_cents": line_total,
                    "agreement_id": auth[0]["agreement_id"],
                })
            invoice = {
                "invoice_id": invoice_id,
                "state": "DRAFT",
                "stop_id": stop_id,
                "site_id": row["site_id"],
                "route_id": row["route_id"],
                "service_date": row["service_date"],
                "currency": "USD",
                "lines": lines,
                "total_cents": total,
                "authority": {
                    "customer_messaging": False,
                    "provider_navigation": False,
                    "accounting_mutation": False,
                    "payment_mutation": False,
                    "deployment": False,
                    "revenue_assertion": False,
                    "sanitation_certification": False,
                    "quality_inference": False,
                },
            }
            conn.execute(
                "INSERT INTO invoices(invoice_id,stop_id,state,total_cents,payload_json) VALUES (?,?,'DRAFT',?,?)",
                (invoice_id, stop_id, total, _canonical_json(invoice)),
            )
            changed = conn.execute(
                "UPDATE stops SET state='INVOICE_DRAFTED' WHERE stop_id=? AND state='DELIVERED'", (stop_id,)
            ).rowcount
            if changed != 1:
                raise StateConflict("invoice drafting lost a concurrent terminal race")
            return invoice

        return self._operation(operation_key, "INVOICE_DRAFTED", "invoice", invoice_id, payload, mutate)

    def _phase_counts(self, conn: sqlite3.Connection, stop_id: str, phase: str) -> dict[str, int]:
        return {
            row["item_code"]: row["qty"]
            for row in conn.execute(
                "SELECT item_code,qty FROM linen_counts WHERE stop_id=? AND phase=? ORDER BY item_code",
                (stop_id, phase),
            )
        }

    def _insert_exception(
        self, conn: sqlite3.Connection, stop_id: str, kind: str, item_code: str, expected: int, actual: int
    ) -> str:
        ordinal = conn.execute("SELECT COUNT(*) FROM exceptions WHERE stop_id=?", (stop_id,)).fetchone()[0] + 1
        exception_id = _generated_id("exc", stop_id, f"{ordinal:04d}")
        conn.execute(
            "INSERT INTO exceptions(exception_id,stop_id,kind,item_code,expected_qty,actual_qty,status) "
            "VALUES (?,?,?,?,?,?,'OPEN')",
            (exception_id, stop_id, kind, item_code, expected, actual),
        )
        return exception_id

    def _maybe_complete_route(self, conn: sqlite3.Connection, route_id: str) -> None:
        pending = conn.execute(
            "SELECT COUNT(*) FROM stops WHERE route_id=? AND state NOT IN ('DELIVERED','INVOICE_DRAFTED')", (route_id,)
        ).fetchone()[0]
        if pending == 0:
            conn.execute("UPDATE routes SET state='COMPLETE' WHERE route_id=?", (route_id,))

    def route_snapshot(self, route_id: str) -> dict[str, Any]:
        route_id = _ident(route_id, "route_id")
        with closing(self._connect()) as conn:
            route = conn.execute(
                "SELECT route_id,service_date,route_code,state FROM routes WHERE route_id=?", (route_id,)
            ).fetchone()
            if not route:
                raise ValidationError("unknown route")
            stops: list[dict[str, Any]] = []
            for row in conn.execute(
                "SELECT s.stop_id,s.site_id,s.stop_sequence,s.state,si.customer_id,si.name site_name,c.name customer_name "
                "FROM stops s JOIN sites si ON si.site_id=s.site_id JOIN customers c ON c.customer_id=si.customer_id "
                "WHERE s.route_id=? ORDER BY s.stop_sequence,s.site_id", (route_id,)
            ):
                exceptions = [
                    dict(r)
                    for r in conn.execute(
                        "SELECT exception_id,kind,item_code,expected_qty,actual_qty,status,resolution_code,resolution_note "
                        "FROM exceptions WHERE stop_id=? ORDER BY exception_id", (row["stop_id"],)
                    )
                ]
                invoice_row = conn.execute(
                    "SELECT payload_json FROM invoices WHERE stop_id=?", (row["stop_id"],)
                ).fetchone()
                stops.append({
                    "stop_id": row["stop_id"],
                    "site_id": row["site_id"],
                    "site_name": row["site_name"],
                    "customer_id": row["customer_id"],
                    "customer_name": row["customer_name"],
                    "sequence": row["stop_sequence"],
                    "state": row["state"],
                    "pickup_counts": self._phase_counts(conn, row["stop_id"], "PICKUP"),
                    "processed_counts": self._phase_counts(conn, row["stop_id"], "PROCESSED"),
                    "damaged_counts": self._phase_counts(conn, row["stop_id"], "DAMAGED"),
                    "delivered_counts": self._phase_counts(conn, row["stop_id"], "DELIVERED"),
                    "pickup_containers": [
                        r[0] for r in conn.execute(
                            "SELECT container_id FROM container_custody WHERE stop_id=? AND phase='PICKUP' ORDER BY container_id",
                            (row["stop_id"],),
                        )
                    ],
                    "delivery_containers": [
                        r[0] for r in conn.execute(
                            "SELECT container_id FROM container_custody WHERE stop_id=? AND phase='DELIVERY' ORDER BY container_id",
                            (row["stop_id"],),
                        )
                    ],
                    "exceptions": exceptions,
                    "invoice": json.loads(invoice_row[0]) if invoice_row else None,
                })
            return {
                "route_id": route["route_id"],
                "service_date": route["service_date"],
                "route_code": route["route_code"],
                "state": route["state"],
                "stops": stops,
                "authority": {
                    "customer_messaging": False,
                    "provider_navigation": False,
                    "accounting_mutation": False,
                    "payment_mutation": False,
                    "deployment": False,
                    "revenue_assertion": False,
                    "sanitation_certification": False,
                    "quality_inference": False,
                },
            }

    def customer_snapshot(self, customer_id: str) -> dict[str, Any]:
        customer_id = _ident(customer_id, "customer_id")
        with closing(self._connect()) as conn:
            customer = conn.execute(
                "SELECT customer_id,name FROM customers WHERE customer_id=?", (customer_id,)
            ).fetchone()
            if not customer:
                raise ValidationError("unknown customer")
            sites: list[dict[str, Any]] = []
            for site in conn.execute(
                "SELECT site_id,name FROM sites WHERE customer_id=? ORDER BY site_id", (customer_id,)
            ):
                agreements = [
                    dict(r)
                    for r in conn.execute(
                        "SELECT agreement_id,item_code,unit_price_cents,active_from,active_to "
                        "FROM agreements WHERE site_id=? ORDER BY item_code,active_from,agreement_id",
                        (site["site_id"],),
                    )
                ]
                sites.append({"site_id": site["site_id"], "name": site["name"], "agreements": agreements})
            return {
                "customer_id": customer["customer_id"],
                "name": customer["name"],
                "sites": sites,
                "authority": {
                    "customer_messaging": False,
                    "provider_navigation": False,
                    "accounting_mutation": False,
                    "payment_mutation": False,
                    "deployment": False,
                    "revenue_assertion": False,
                    "sanitation_certification": False,
                    "quality_inference": False,
                },
            }

    def render_route_exports(self, route_id: str) -> dict[str, str]:
        snap = self.route_snapshot(route_id)
        json_text = json.dumps(snap, sort_keys=True, indent=2, ensure_ascii=False) + "\n"
        csv_buf = io.StringIO(newline="")
        writer = csv.writer(csv_buf, lineterminator="\n")
        writer.writerow([
            "route_id", "service_date", "route_code", "stop_id", "sequence", "customer_id", "site_id",
            "state", "open_exceptions", "invoice_state", "invoice_total_cents",
        ])
        for stop in snap["stops"]:
            open_count = sum(1 for exc in stop["exceptions"] if exc["status"] == "OPEN")
            invoice = stop["invoice"]
            writer.writerow([
                snap["route_id"], snap["service_date"], snap["route_code"], stop["stop_id"], stop["sequence"],
                stop["customer_id"], stop["site_id"], stop["state"], open_count,
                invoice["state"] if invoice else "", invoice["total_cents"] if invoice else "",
            ])
        md = [
            f"# Route {snap['route_id']}", "", f"- Service date: `{snap['service_date']}`",
            f"- Route code: `{snap['route_code']}`", f"- State: `{snap['state']}`", "",
            "| Seq | Customer | Site | State | Open exceptions | Invoice |",
            "|---:|---|---|---|---:|---|",
        ]
        for stop in snap["stops"]:
            open_count = sum(1 for exc in stop["exceptions"] if exc["status"] == "OPEN")
            invoice = stop["invoice"]
            if invoice:
                dollars, cents = divmod(invoice["total_cents"], 100)
                inv = f"DRAFT ${dollars}.{cents:02d}"
            else:
                inv = "—"
            md.append(
                f"| {stop['sequence']} | {stop['customer_id']} | {stop['site_id']} | {stop['state']} | {open_count} | {inv} |"
            )
        md += ["", "Authority flags: all customer/provider/payment/deployment/revenue authority is `false`.", ""]
        return {"json": json_text, "csv": csv_buf.getvalue(), "markdown": "\n".join(md)}

    def render_customer_exports(self, customer_id: str) -> dict[str, str]:
        snap = self.customer_snapshot(customer_id)
        json_text = json.dumps(snap, sort_keys=True, indent=2, ensure_ascii=False) + "\n"
        csv_buf = io.StringIO(newline="")
        writer = csv.writer(csv_buf, lineterminator="\n")
        writer.writerow([
            "customer_id", "customer_name", "site_id", "site_name", "agreement_id", "item_code",
            "unit_price_cents", "active_from", "active_to",
        ])
        for site in snap["sites"]:
            for agreement in site["agreements"]:
                writer.writerow([
                    snap["customer_id"], _csv_safe(snap["name"]), site["site_id"], _csv_safe(site["name"]),
                    agreement["agreement_id"], agreement["item_code"], agreement["unit_price_cents"],
                    agreement["active_from"], agreement["active_to"] or "",
                ])
        md = [
            f"# Customer {snap['customer_id']}", "", f"Name: {_md_literal(snap['name'])}", "",
            "| Site | Site name | Item | Unit price (cents) | Effective |",
            "|---|---|---|---:|---|",
        ]
        for site in snap["sites"]:
            for agreement in site["agreements"]:
                end = agreement["active_to"] or "open"
                md.append(
                    f"| {site['site_id']} | {_md_literal(site['name'])} | {agreement['item_code']} | "
                    f"{agreement['unit_price_cents']} | {agreement['active_from']}..{end} |"
                )
        md += ["", "Authority flags: all customer/provider/payment/deployment/revenue authority is `false`.", ""]
        return {"json": json_text, "csv": csv_buf.getvalue(), "markdown": "\n".join(md)}

    def event_history(self) -> list[dict[str, Any]]:
        with closing(self._connect()) as conn:
            return [
                dict(row)
                for row in conn.execute(
                    "SELECT seq,operation_key,payload_hash,event_type,entity_type,entity_id,event_json,created_at "
                    "FROM events ORDER BY seq"
                )
            ]

    def verify_integrity(self) -> dict[str, Any]:
        with closing(self._connect()) as conn:
            events = conn.execute(
                "SELECT e.operation_key,e.payload_hash,e.event_json,o.payload_hash op_hash,o.result_json "
                "FROM events e JOIN operations o ON o.operation_key=e.operation_key ORDER BY e.seq"
            ).fetchall()
            op_count = conn.execute("SELECT COUNT(*) FROM operations").fetchone()[0]
            if len(events) != op_count:
                raise LaundryDeskError("operation/event cardinality mismatch")
            for row in events:
                event = json.loads(row["event_json"])
                if _hash_payload(event["input"]) != row["payload_hash"] or row["payload_hash"] != row["op_hash"]:
                    raise LaundryDeskError("operation/event payload digest mismatch")
                if _canonical_json(event["result"]) != row["result_json"]:
                    raise LaundryDeskError("operation/event result mismatch")
            return {
                "schema_version": SCHEMA_VERSION,
                "operations": op_count,
                "events": len(events),
                "integrity": "PASS",
                "authority": {
                    "customer_messaging": False,
                    "provider_navigation": False,
                    "accounting_mutation": False,
                    "payment_mutation": False,
                    "deployment": False,
                    "revenue_assertion": False,
                    "sanitation_certification": False,
                    "quality_inference": False,
                },
            }
