{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woahwhattheheck.github.io/commons/revenue/right_now/control.schema.json",
  "title": "Commons right-now revenue control",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "as_of",
    "truth",
    "payment",
    "offers",
    "execution_queue",
    "blockers",
    "preserved_portfolio",
    "source_receipts"
  ],
  "properties": {
    "schema_version": {"const": "commons-right-now-control/v1"},
    "kind": {"const": "RIGHT_NOW_REVENUE_CONTROL"},
    "as_of": {"type": "string", "format": "date-time"},
    "truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collected_cash_usd", "verified_positive_replies", "accepted_scopes", "active_chargeable_checkout", "prospects_evaluated", "ready_to_draft", "transport_actions"],
      "properties": {
        "collected_cash_usd": {"type": "integer", "minimum": 0},
        "verified_positive_replies": {"type": "integer", "minimum": 0},
        "accepted_scopes": {"type": "integer", "minimum": 0},
        "active_chargeable_checkout": {"type": "boolean"},
        "prospects_evaluated": {"type": "integer", "minimum": 0},
        "ready_to_draft": {"type": "integer", "minimum": 0},
        "transport_actions": {"type": "integer", "minimum": 0}
      }
    },
    "payment": {"type": "object"},
    "offers": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "execution_queue": {"type": "array", "items": {"type": "object"}},
    "blockers": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "preserved_portfolio": {"type": "object"},
    "source_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
