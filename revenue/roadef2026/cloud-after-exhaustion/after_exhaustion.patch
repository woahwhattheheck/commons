+                  << "\",\"elapsed\":" << phaseEnd << ",\"phase_seconds\":" << (phaseEnd - phaseStart)
+                  << ",\"remaining\":" << std::max(0.0, seconds - phaseEnd)
+                  << ",\"attempted\":" << (attempted - attemptsBefore)
+                  << ",\"accepted\":" << (accepted - acceptedBefore) << "}\n";
+    }
