{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/mcp.py": {
      "maxDuration": 300
    }
  },
    "rewrites": [
    {
      "source": "/",
      "destination": "/api/mcp"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/send",
      "destination": "/api/mcp"
    },
    {
      "source": "/carriers",
      "destination": "/api/mcp"
    },
    {
      "source": "/carriers/:path*",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "/api/mcp"
    }
  ]
}

