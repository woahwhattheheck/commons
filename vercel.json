{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/mcp.py": {
      "maxDuration": 300
    },
    "api/owner_context.py": {
      "maxDuration": 10
    },
    "api/jev.py": {
      "maxDuration": 60
    },
    "api/cua_s1.py": {
      "maxDuration": 60
    },
    "api/cua_s1_form.mjs": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/mcp"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/send",
      "destination": "/api/mcp"
    },
    {
      "source": "/webmcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/webmcp.html",
      "destination": "/api/mcp"
    },
    {
      "source": "/capabilities",
      "destination": "/api/mcp"
    },
    {
      "source": "/harnesses",
      "destination": "/api/mcp"
    },
    {
      "source": "/carriers",
      "destination": "/api/mcp"
    },
    {
      "source": "/carriers/:path*",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/commons-capabilities.json",
      "destination": "/api/mcp"
    },
    {
      "source": "/owner-context",
      "destination": "/api/owner_context"
    },
    {
      "source": "/owner-context/",
      "destination": "/api/owner_context"
    },
    {
      "source": "/jev",
      "destination": "/api/jev"
    },
    {
      "source": "/jev/",
      "destination": "/api/jev"
    },
    {
      "source": "/cua-s1",
      "destination": "/api/cua_s1"
    },
    {
      "source": "/cua-s1/",
      "destination": "/api/cua_s1"
    },
    {
      "source": "/cua-s1/form",
      "destination": "/api/cua_s1_form"
    },
    {
      "source": "/cua-s1/form/",
      "destination": "/api/cua_s1_form"
    },
    {
      "source": "/cua-s1/fixture",
      "destination": "/api/cua_s1_fixture"
    }
  ]
}
