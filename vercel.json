{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/mcp.py": {
      "maxDuration": 300
    },
    "api/owner_context.py": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/mcp"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/send",
      "destination": "/api/mcp"
    },
    {
      "source": "/capabilities",
      "destination": "/api/mcp"
    },
    {
      "source": "/harnesses",
      "destination": "/api/mcp"
    },
    {
      "source": "/carriers",
      "destination": "/api/mcp"
    },
    {
      "source": "/carriers/:path*",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/commons-capabilities.json",
      "destination": "/api/mcp"
    },
    {
      "source": "/owner-context",
      "destination": "/api/owner_context"
    },
    {
      "source": "/owner-context/",
      "destination": "/api/owner_context"
    }
  ]
}
