@@ -0,0 +1,44 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import {
+  rankMoltbookOpportunities,
+  scoreMoltbookOpportunity,
+} from '../src/opportunities.ts';
+
+const cases = JSON.parse(
+  readFileSync(
+    new URL('../tests/fixtures/opportunity_amount_cases.json', import.meta.url),
+    'utf8',
+  ),
+);
+
+for (const fixture of cases) {
+  test(fixture.name, () => {
+    const original = { ...fixture.post };
+    for (let attempt = 0; attempt < 2; attempt += 1) {
+      assert.deepEqual(scoreMoltbookOpportunity(fixture.post), {
+        score: fixture.score,
+        signals: fixture.signals,
+      });
+      assert.equal(
+        rankMoltbookOpportunities([fixture.post]).length > 0,
+        fixture.score >= 3,
+      );
+    }
+    assert.deepEqual(fixture.post, original);
+  });
+}
+
+test('ranking filters prices and preserves ties and limit', () => {
+  const posts = [
+    { id: 'price', content: '$2.50–$15.00/M tokens', upvotes: 999 },
+    { id: 'first', content: '100 USDC for a logo', upvotes: 7 },
+    { id: 'second', content: '100 USDC for a logo', upvotes: 7 },
+    { id: 'bounty', content: 'Bounty: review this parser', upvotes: 0 },
+  ];
+  assert.deepEqual(
+    rankMoltbookOpportunities(posts, 2).map((post) => post.id),
+    ['bounty', 'first'],
+  );
+});
