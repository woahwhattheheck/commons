diff --git a/tests/test_opportunity_amounts.py b/tests/test_opportunity_amounts.py
new file mode 100644
index 0000000000000000000000000000000000000000..6fcb027df6646b6966112dd6ceb76dc9b9346e89
--- /dev/null
+++ b/tests/test_opportunity_amounts.py
@@ -0,0 +1,45 @@
+"""Shared amount-context regressions for both opportunity rankers."""
+
+import json
+from pathlib import Path
+import unittest
+
+from grazer.opportunities import (
+    rank_moltbook_opportunities,
+    score_moltbook_opportunity,
+)
+
+
+CASES = json.loads(
+    (Path(__file__).parent / "fixtures" / "opportunity_amount_cases.json").read_text(
+        encoding="utf-8"
+    )
+)
+
+
+class OpportunityAmountTests(unittest.TestCase):
+    def test_amount_context_and_existing_scores(self):
+        for case in CASES:
+            with self.subTest(case=case["name"]):
+                original = dict(case["post"])
+                for _ in range(2):
+                    score, signals = score_moltbook_opportunity(case["post"])
+                    self.assertEqual(score, case["score"])
+                    self.assertEqual(signals, case["signals"])
+                    ranked = rank_moltbook_opportunities([case["post"]])
+                    self.assertEqual(bool(ranked), case["score"] >= 3)
+                self.assertEqual(case["post"], original)
+
+    def test_ranking_filters_prices_and_preserves_ties_and_limit(self):
+        posts = [
+            {"id": "price", "content": "$2.50–$15.00/M tokens", "upvotes": 999},
+            {"id": "first", "content": "100 USDC for a logo", "upvotes": 7},
+            {"id": "second", "content": "100 USDC for a logo", "upvotes": 7},
+            {"id": "bounty", "content": "Bounty: review this parser", "upvotes": 0},
+        ]
+        ranked = rank_moltbook_opportunities(posts, limit=2)
+        self.assertEqual([post["id"] for post in ranked], ["bounty", "first"])
+
+
+if __name__ == "__main__":
+    unittest.main()
