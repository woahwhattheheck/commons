          "adapter_expects": false,
          "default": false,
          "note": "diagnostic probe; always resolves to a redacted error code, never to data",
          "advisory": true
        },
        "probe_undeclared": {
          "type": "flag",
          "required": false,
          "adapter_expects": false,
          "default": false,
          "note": "diagnostic probe; always resolves to a redacted error code, never to data",
          "advisory": true
