          "height": {
            "type": "count",
            "min": 0,
            "max": 9007199254740992
          },
          "depth": {
            "type": "count",
            "min": 0,
            "max": 9007199254740992
          },
          "cell_count": {
            "type": "count",
            "min": 0,
            "max": 9007199254740992
