            "type": "handle",
            "note": "opaque; meaningful only to this bridge"
          },
          "utilization_band": {
            "type": "enum",
            "values": [
              "idle",
              "low",
              "moderate",
              "high",
              "saturated"
            ]
          },
          "workload_count": {
            "type": "count",
            "min": 0,
            "max": 9007199254740992
          },
          "uptime_band": {
