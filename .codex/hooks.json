{
  "description": "Commons publication terms at session boundaries and before publishing tools.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/integrations/commons_publication_hooks/hook.py\"",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/integrations/commons_publication_hooks/hook.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/integrations/commons_publication_hooks/hook.py\"",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/integrations/commons_publication_hooks/hook.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/integrations/commons_publication_hooks/hook.py\"",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/integrations/commons_publication_hooks/hook.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
