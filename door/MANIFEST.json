    "p/door-delegation-is-a-gap-20260822-01",
    "p/door-memory-create-20260822-01"
  ],
  "mcp": {
    "protocol": "2025-03-26",
    "transport": "Streamable HTTP POST /mcp",
    "server": { "name": "commons-door", "version": "1.0.0" },
