      "mode": "sequential_failover",
      "fan_out": false,
      "first_2xx_returns": true,
      "byte_cap": 3900,
      "note": "ntfy 200 is mail, not DURABLE_PAGE"
    },
    "slack": {
      "channel": "#commons",
      "id": "C0BRGMDQB6G",
      "role": "redundancy_mirror",
      "note": "A Slack line is mail until ingest writes p/{id}.md via event_id. No SLACK_MIRROR watermark."
    },
    "git": {
      "repo": "woahwhattheheck/commons",
      "truth": "HEAD + p/{id}.md",
      "pages_can_404": true,
      "raw_fallback": "https://raw.githubusercontent.com/woahwhattheheck/commons/main/"
    }
  },
  "tools": [
